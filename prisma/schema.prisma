model CaseState {
  state         String  @id
  sortOrder     Int     @map("sort_order")
  customerLabel String  @map("customer_label")
  isTerminal    Boolean @default(false) @map("is_terminal")

  cases           ServiceCase[]
  transitionsFrom CaseTransition[] @relation("CaseTransitionFrom")
  transitionsTo   CaseTransition[] @relation("CaseTransitionTo")

  @@map("case_states")
}

model CaseTransition {
  id             String    @id @default(uuid()) @db.Char(36)
  fromState      String    @map("from_state")
  toState        String    @map("to_state")
  requiresReason Boolean   @default(false) @map("requires_reason")
  from           CaseState @relation("CaseTransitionFrom", fields: [fromState], references: [state], onDelete: Restrict)
  to             CaseState @relation("CaseTransitionTo", fields: [toState], references: [state], onDelete: Restrict)

  @@unique([fromState, toState])
  @@map("case_transitions")
}

model Organization {
  id              String    @id @default(uuid()) @db.Char(36)
  orgType         String    @map("org_type")
  legalName       String    @map("legal_name")
  operatingName   String?   @map("operating_name")
  contactName     String?   @map("contact_name")
  contactEmail    String?   @map("contact_email")
  contactPhone    String?   @map("contact_phone")
  address         String?   @db.Text
  serviceArea     String?   @map("service_area")
  /// String array stored as JSON (MySQL has no text[]).
  capabilities    Json      @default("[]")
  approvalStatus  String    @default("Pending") @map("approval_status")
  agreementStatus String    @default("Not Started") @map("agreement_status")
  active          Boolean   @default(true)
  notes           String?   @db.Text
  legacy          Boolean   @default(false)
  operatingHours  String?   @map("operating_hours")
  latitude        Float?
  longitude       Float?
  suspendedAt     DateTime? @map("suspended_at")
  statusReason    String?   @map("status_reason") @db.Text
  commissionRate  Decimal?  @map("commission_rate") @db.Decimal(8, 4)
  payoutRule      String?   @map("payout_rule") @db.Text
  payoutMethod    String?   @map("payout_method")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  members          OrganizationMember[]
  documents        OrganizationDocument[]
  assignedCases    ServiceCase[]
  transportJobs    TransportJob[]
  partsListings    PartsListing[]
  suppliedOrders   PartsOrder[]           @relation("PartsOrderSupplier")
  orderingOrders   PartsOrder[]           @relation("PartsOrderOrderingOrg")
  payouts          Payout[]
  partnerOverrides PartnerOverride[]
  ledgerEntries    LedgerEntry[]

  @@index([orgType])
  @@index([approvalStatus])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id") @db.Char(36)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgRole        String       @default("member") @map("org_role")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model OrganizationDocument {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storagePath    String       @map("storage_path")
  fileName       String       @map("file_name")
  docType        String       @default("Other") @map("doc_type")
  uploadedById   String?      @map("uploaded_by") @db.Char(36)
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  expiresOn      DateTime?    @map("expires_on") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([uploadedById])
  @@map("organization_documents")
}

/// Service case. Named ServiceCase so it does not clash with the JS `case` keyword.
model ServiceCase {
  id                 String           @id @default(uuid()) @db.Char(36)
  caseRef            String           @unique @map("case_ref")
  customerId         String?          @map("customer_id") @db.Char(36)
  customer           User?            @relation("CaseCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  vehicleId          String?          @map("vehicle_id") @db.Char(36)
  vehicle            CustomerVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  origin             String           @default("booking")
  serviceSummary     String           @map("service_summary") @db.Text
  state              String           @default("Requested")
  caseState          CaseState        @relation(fields: [state], references: [state], onDelete: Restrict)
  priority           String           @default("Normal")
  assignedOpsId      String?          @map("assigned_ops_id") @db.Char(36)
  assignedOps        User?            @relation("CaseAssignedOps", fields: [assignedOpsId], references: [id], onDelete: SetNull)
  assignedOrgId      String?          @map("assigned_org_id") @db.Char(36)
  assignedOrg        Organization?    @relation(fields: [assignedOrgId], references: [id], onDelete: SetNull)
  stateChangeReason  String?          @map("state_change_reason") @db.Text
  legacy             Boolean          @default(false)
  shopResponse       String           @default("Pending") @map("shop_response")
  shopResponseReason String?          @map("shop_response_reason") @db.Text
  shopRespondedAt    DateTime?        @map("shop_responded_at")
  isDemo             Boolean          @default(false) @map("is_demo")
  openedAt           DateTime         @default(now()) @map("opened_at")
  closedAt           DateTime?        @map("closed_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  links             CaseLink[]
  events            CaseEvent[]
  auditEvents       AuditEvent[]
  bookings          Booking[]
  roadsideRequests  RoadsideRequest[]
  estimates         Estimate[]
  invoices          Invoice[]
  messages          Message[]
  bookingEvents     BookingEvent[]
  bookingReminders  BookingReminder[]
  internalNotes     InternalNote[]
  inspections       Inspection[]
  media             CaseMedia[]
  estimateApprovals EstimateApproval[]
  notifications     Notification[]
  serviceHistory    ServiceHistory[]
  transportJobs     TransportJob[]
  transportEvents   TransportEvent[]
  parts             CasePart[]
  partsOrders       PartsOrder[]
  payments          Payment[]
  payouts           Payout[]
  refunds           Refund[]
  adjustments       Adjustment[]
  ledgerEntries     LedgerEntry[]

  @@index([customerId])
  @@index([state])
  @@index([assignedOrgId])
  @@index([vehicleId])
  @@map("cases")
}

model CaseLink {
  id          String      @id @default(uuid()) @db.Char(36)
  caseId      String      @map("case_id") @db.Char(36)
  serviceCase ServiceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  recordType  String      @map("record_type")
  recordId    String      @map("record_id") @db.Char(36)
  createdAt   DateTime    @default(now()) @map("created_at")

  @@unique([caseId, recordType, recordId])
  @@index([caseId])
  @@map("case_links")
}

model CaseEvent {
  id              String      @id @default(uuid()) @db.Char(36)
  caseId          String      @map("case_id") @db.Char(36)
  serviceCase     ServiceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  eventType       String      @map("event_type")
  actorId         String?     @map("actor_id") @db.Char(36)
  actor           User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole       String?     @map("actor_role")
  customerVisible Boolean     @default(true) @map("customer_visible")
  title           String
  body            String?     @db.Text
  occurredAt      DateTime    @default(now()) @map("occurred_at")

  @@index([caseId, occurredAt])
  @@index([actorId])
  @@map("case_events")
}

model AuditEvent {
  id          String       @id @default(uuid()) @db.Char(36)
  actorId     String?      @map("actor_id") @db.Char(36)
  actor       User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  entityType  String       @map("entity_type")
  entityId    String?      @map("entity_id") @db.Char(36)
  caseId      String?      @map("case_id") @db.Char(36)
  serviceCase ServiceCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  before      Json?
  after       Json?
  reason      String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([caseId])
  @@index([actorId])
  @@map("audit_events")
}

model Booking {
  id                  String            @id @default(uuid()) @db.Char(36)
  userId              String            @map("user_id") @db.Char(36)
  user                User              @relation("BookingCustomer", fields: [userId], references: [id], onDelete: Cascade)
  vehicleId           String?           @map("vehicle_id") @db.Char(36)
  vehicle             CustomerVehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  shopId              String?           @map("shop_id") @db.Char(36)
  shop                RepairShop?       @relation(fields: [shopId], references: [id], onDelete: SetNull)
  serviceType         String            @map("service_type")
  description         String?           @db.Text
  preferredDate       DateTime?         @map("preferred_date") @db.Date
  preferredTime       String?           @map("preferred_time")
  location            String?           @db.Text
  needsPickup         Boolean           @default(false) @map("needs_pickup")
  status              String            @default("Requested")
  scheduledAt         DateTime?         @map("scheduled_at")
  assignedStaffId     String?           @map("assigned_staff_id") @db.Char(36)
  assignedStaff       User?             @relation("BookingAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  routingNote         String?           @map("routing_note") @db.Text
  slotId              String?           @map("slot_id") @db.Char(36)
  slot                AvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  caseId              String?           @map("case_id") @db.Char(36)
  serviceCase         ServiceCase?      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  specialInstructions String?           @map("special_instructions") @db.Text
  unsureService       Boolean           @default(false) @map("unsure_service")
  createdByStaffId    String?           @map("created_by_staff_id") @db.Char(36)
  createdByStaff      User?             @relation("BookingCreatedByStaff", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  events         BookingEvent[]
  estimates      Estimate[]
  invoices       Invoice[]
  messages       Message[]
  reminders      BookingReminder[]
  inspections    Inspection[]
  media          CaseMedia[]
  serviceHistory ServiceHistory[]
  ledgerEntries  LedgerEntry[]

  @@index([userId])
  @@index([vehicleId])
  @@index([caseId])
  @@index([slotId])
  @@map("bookings")
}

model BookingEvent {
  id          String       @id @default(uuid()) @db.Char(36)
