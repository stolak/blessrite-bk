// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// datasource db {
// provider = "postgresql"
// url      = env("DATABASE_URL")
// }

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

// datasource db {
//   provider = "postgresql"
//   url      = env("DATABASE_URL")
// }

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserType {
  SuperAdmin
  Staff
  Driver
  Customer
}

enum Status {
  Active
  Inactive
  Archived
}

enum JournalTransferType {
  Debit
  Credit
}

enum BatchStatus {
  Pending
  Processed
  Failed
}

enum InventoryCategoryType {
  Consumable
  NonConsumable
}

model Privilege {
  id           String               @id @default(uuid()) @db.Char(36)
  name         String               @unique
  description  String?
  userLinks    PrivilegeToUser[]
  appRoleLinks AppRoleToPrivilege[]

  @@map("privileges")
}

model User {
  id              String   @id @default(uuid()) @db.Char(36)
  password        String
  firstName       String?
  lastName        String?
  profileImageUrl String?
  phoneNumber     String?
  email           String   @unique
  userType        UserType @default(Staff)
  isActive        Boolean  @default(false)
  isVerified      Boolean  @default(false)
  isEmailVerified Boolean  @default(false)
  isPhoneVerified Boolean  @default(false)
  isDeleted       Boolean  @default(false)

  createdById  String? @db.Char(36)
  approvedById String? @db.Char(36)
  modifiedById String? @db.Char(36)

  createdBy  User? @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User? @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  modifiedBy User? @relation("ModifiedBy", fields: [modifiedById], references: [id], onDelete: SetNull)

  createdUsers  User[] @relation("CreatedBy")
  approvedUsers User[] @relation("ApprovedBy")
  modifiedUsers User[] @relation("ModifiedBy")

  status       String   @default("active")
  referralCode String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Password reset tokens
  passwordResetTokens PasswordResetToken[]

  // Inventory/School domain relations
  userRoles             UserRole[]
  staffProfile          Staff?                 @relation("StaffUser")
  createdSuppliers      Supplier[]             @relation("SupplierCreatedBy")
  createdStaff          Staff[]                @relation("StaffCreatedBy")
  tempJournalTransfers TempJournalTransfer[]

  privilegeLinks PrivilegeToUser[]
  auditLogs      AuditLog[]
  cashiers       Cashier[]

  salaryChartsCreated           SalaryChart[]                  @relation("SalaryChartCreatedBy")
  salaryChartsUpdated           SalaryChart[]                  @relation("SalaryChartUpdatedBy")
  staffSalaryOverrideComponents StaffSalaryOverrideComponent[] @relation("StaffSalaryOverrideCreatedBy")
  payrollProcesses              PayrollProcess[]               @relation("PayrollProcesses")
  payrollProcessesApproved      PayrollProcess[]               @relation("PayrollProcessesApproved")
  payrollProcessesPosted        PayrollProcess[]               @relation("PayrollProcessesPosted")
  administrativeExpensesCreated AdministrativeExpense[]        @relation("AdministrativeExpenseCreatedBy")
  administrativeExpensesUpdated AdministrativeExpense[]        @relation("AdministrativeExpenseUpdatedBy")
  vehicles                      Vehicle[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Bank {
  id       String @id @default(uuid()) @db.Char(36)
  bankCode String @unique
  bankName String

  @@map("banks")
}

enum RecordStatus {
  active
  inactive
  archived
}

enum StudentStatus {
  Active
  Inactive
  Graduated
  Transferred
  Suspended
  Archived
}

enum Gender {
  male
  female
  other
}

enum InventoryTransactionType {
  purchase
  donation
  student_purchase

  student_collection
  hostel_collection
  departmental_collection
  staff_collection
  project_collection
  facility_collection

  student_return
  hostel_return
  departmental_return
  staff_return
  facility_return
  sales
  disposal
  store_transfer
}

enum InventoryTransactionStatus {
  pending
  cancelled
  deleted
  completed
}

enum StaffPosition {
  class_teacher
  assistant_teacher
  subject_teacher
  principal
  vice_principal
  teacher
  admin
  other
}

/// Named `AppRole` to avoid colliding with your existing `Role` enum.
model AppRole {
  id     String @id @default(uuid()) @db.Char(36)
  name   String
  status String @default("active")

  roleMenus      RoleMenu[]
  userRoles      UserRole[]
  privilegeLinks AppRoleToPrivilege[]

  @@map("roles")
}

/// Explicit join table (replaces Prisma implicit `_PrivilegeToUser`).
model PrivilegeToUser {
  privilegeId String    @map("privilege_id") @db.Char(36)
  privilege   Privilege @relation(fields: [privilegeId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id") @db.Char(36)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([privilegeId, userId])
  @@index([userId])
  @@map("_privilege_to_user")
}

/// Explicit join table (replaces Prisma implicit `_AppRoleToPrivilege`).
model AppRoleToPrivilege {
  appRoleId   String    @map("app_role_id") @db.Char(36)
  appRole     AppRole   @relation(fields: [appRoleId], references: [id], onDelete: Cascade)
  privilegeId String    @map("privilege_id") @db.Char(36)
  privilege   Privilege @relation(fields: [privilegeId], references: [id], onDelete: Cascade)

  @@id([appRoleId, privilegeId])
  @@index([privilegeId])
  @@map("_app_role_to_privilege")
}

model Menu {
  id            String         @id @default(uuid()) @db.Char(36)
  route         String         @unique
  caption       String
  status        Status         @default(Active)
  roleMenus     RoleMenu[]
  menuChildrens MenuChildren[]

  @@map("menus")
}

model MenuChildren {
  id        String   @id @default(uuid()) @db.Char(36)
  menuId    String   @map("menu_id") @db.Char(36)
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name      String
  route     String
  status    Status   @default(Active)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  /// Per-role grants for this child under a parent RoleMenu assignment.
  roleMenuChildren RoleMenuChild[]

  @@index([menuId])
  @@map("menu_children")
}

model RoleMenu {
  id     String @id @default(uuid()) @db.Char(36)
  roleId String @map("role_id") @db.VarChar(50)
  menuId String @map("menu_id") @db.Char(36)

  menu Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  role AppRole? @relation(fields: [roleId], references: [id])

  /// Selected child routes under this role+parent menu. Empty = all active children.
  roleMenuChildren RoleMenuChild[]

  @@unique([roleId, menuId])
  @@index([roleId])
  @@index([menuId])
  @@map("role_menus")
}

/// Grants a role access to specific child items under an assigned parent menu (RoleMenu).
/// A row links one RoleMenu assignment to one MenuChildren entry.
/// Resolution: if no rows exist for a RoleMenu, the role sees all active MenuChildren of that menu;
/// if one or more rows exist, only those children are visible (whitelist).
model RoleMenuChild {
  id          String @id @default(uuid()) @db.Char(36)
  roleMenuId  String @map("role_menu_id") @db.Char(36)
  menuChildId String @map("menu_child_id") @db.Char(36)

  roleMenu  RoleMenu     @relation(fields: [roleMenuId], references: [id], onDelete: Cascade)
  menuChild MenuChildren @relation(fields: [menuChildId], references: [id], onDelete: Cascade)

  @@unique([roleMenuId, menuChildId])
  @@index([roleMenuId])
  @@index([menuChildId])
  @@map("role_menu_children")
}

model UserRole {
  userId String @id @map("user_id") @db.Char(36)
  roleId String @map("role_id") @db.Char(36)

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@map("user_roles")
}

model Brand {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique
  status    Status   @default(Active)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("brands")
}

model Supplier {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @unique
  contactName String?  @map("contact_name")
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String?
  website     String?
  notes       String?
  status      Status   @default(Active)
  createdById String?  @map("created_by") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  // accountId             Int?                   @map("account_id")
  // account               AccountChart?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy   User?    @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("suppliers")
}

model ActivePeriod {
  id        String   @id @default(uuid()) @db.Char(36)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("active_period")
}

enum EmploymentType {
  Permanent
  Contractual
  Casual
  Internship
  Volunteer
  PartTime
  Temporary
  Seasonal
  ProjectBased
  Other
}

model Staff {
  id              String         @id @default(uuid()) @db.Char(36)
  StaffNumber     String         @unique @map("staff_number") @db.VarChar(50)
  email           String         @unique
  name            String
  position        StaffPosition  @default(teacher)
  employmentType  EmploymentType @default(Permanent)
  status          Status         @default(Active)
  profileImageUrl String?        @map("profile_image_url")
  createdById     String         @map("created_by") @db.Char(36)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @default(now()) @map("updated_at")
  gradeLevelId    String?        @map("grade_level_id") @db.Char(36)
  gradeLevel      GradeLevel?    @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  step            Int            @default(0) @map("step")
  salary          Decimal        @default(0) @map("salary") @db.Decimal(12, 2)
  createdBy       User           @relation("StaffCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  departmentId    String?        @map("department_id") @db.Char(36)
  department      Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  userId          String?        @unique @db.Char(36)
  user            User?          @relation("StaffUser", fields: [userId], references: [id], onDelete: SetNull)

  cashiers Cashier[]

  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  dateOfAppointment DateTime? @map("date_of_appointment") @db.Date
  dateOfResignation DateTime? @map("date_of_resignation") @db.Date
  dateOfTermination DateTime? @map("date_of_termination") @db.Date

  staffSalaryOverrideComponents StaffSalaryOverrideComponent[]
  payrollProcesses              PayrollProcess[]

  vehicles Vehicle[]

  @@index([userId])
  @@index([StaffNumber])
  @@index([createdById])
  @@map("staffs")
}

/// Chart of accounts: top-level group (e.g. Assets, Liabilities).
model AccountGroup {
  id   Int    @id @default(autoincrement())
  name String @map("name")
  rank Int

  heads               AccountHead[]
  subHeads            AccountSubhead[]
  accountCharts       AccountChart[]
  accountTransactions AccountTransaction[]

  @@map("account_groups")
}

/// Account head under a group (e.g. Cash, Bank).
model AccountHead {
  id      Int    @id @default(autoincrement())
  groupId Int    @map("group_id")
  code    String @map("code")
  name    String @map("name")
  rank    Int

  group               AccountGroup         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  subHeads            AccountSubhead[]
  accountCharts       AccountChart[]
  accountTransactions AccountTransaction[]

  @@index([groupId])
  @@map("account_heads")
}

enum AccountType {
  Cash
  NonCash
}

/// Subhead under a head (detailed ledger line).
model AccountSubhead {
  id            Int         @id @default(autoincrement())
  groupId       Int         @map("group_id")
  headId        Int         @map("head_id")
  code          String?     @map("code")
  name          String      @map("name")
  status        Status      @default(Active)
  rank          Int
  afs           String?     @map("afs")
  paymentMethod String?     @map("payment_method")
  accountType   AccountType @default(NonCash) @map("account_type")

  group                 AccountGroup            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  head                  AccountHead             @relation(fields: [headId], references: [id], onDelete: Restrict)
  accountCharts         AccountChart[]
  accountTransactions   AccountTransaction[]
  defaulSubheadSettings DefaulSubheadSettings[]

  @@index([groupId])
  @@index([headId])
  @@map("account_subheads")
}

/// Ledger / chart row: concrete account number under group, head, and subhead.
model AccountChart {
  id                 Int      @id @default(autoincrement())
  groupId            Int      @map("group_id")
  headId             Int      @map("head_id")
  subheadId          Int      @map("sub_head_id")
  accountNo          String?  @map("account_no")
  accountRef         String?  @map("account_ref")
  accountDescription String   @map("account_description")
  status             Status   @default(Active)
  rank               Int
  createdAt          DateTime @default(now()) @map("created_at")

  group                  AccountGroup             @relation(fields: [groupId], references: [id], onDelete: Restrict)
  head                   AccountHead              @relation(fields: [headId], references: [id], onDelete: Restrict)
  subhead                AccountSubhead           @relation(fields: [subheadId], references: [id], onDelete: Restrict)
  accountTransactions    AccountTransaction[]
  tempJournalTransfers   TempJournalTransfer[]
  defaultAccountSettings DefaultAccountSettings[]
  // suppliers               Supplier[]
  cashiers               Cashier[]

  salaryComponents                SalaryComponent[]
  administrativeExpenseComponents AdministrativeExpenseComponent[]

  @@index([groupId])
  @@index([headId])
  @@index([subheadId])
  @@map("account_charts")
}

/// Posted ledger line (double-entry detail).
model AccountTransaction {
  id              Int      @id @default(autoincrement())
  groupId         Int      @map("group_id")
  headId          Int      @map("head_id")
  subheadId       Int      @map("sub_head_id")
  accountId       Int      @map("account_id")
  accountCode     String?  @map("account_code")
  accountSub      String?  @map("account_sub")
  debit           Decimal  @default(0) @db.Decimal(14, 2)
  credit          Decimal  @default(0) @db.Decimal(14, 2)
  remarks         String?  @map("remarks")
  ref             String?  @map("reference_no")
  manualRef       String?  @map("manual_reference_no")
  transactionDate DateTime @map("transaction_date")
  postedBy        String?  @map("posted_by")
  createdAt       DateTime @default(now()) @map("created_at")
  projectId       String?  @map("project_id") @db.Char(36)

  group   AccountGroup   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  head    AccountHead    @relation(fields: [headId], references: [id], onDelete: Restrict)
  subhead AccountSubhead @relation(fields: [subheadId], references: [id], onDelete: Restrict)
  account AccountChart   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([headId])
  @@index([subheadId])
  @@index([accountId])
  @@index([projectId])
  @@index([transactionDate])
  @@index([accountSub])
  @@map("account_transactions")
}

/// Staging journal lines before transfer to the live ledger.
model TempJournalTransfer {
  id                Int                 @id @default(autoincrement())
  transType         JournalTransferType @map("transaction_type")
  accountId         Int                 @map("accountid")
  debit             Decimal             @default(0) @db.Decimal(14, 2)
  credit            Decimal             @default(0) @db.Decimal(14, 2)
  status            Status              @default(Active)
  batchStatus       BatchStatus         @default(Pending)
  referenceNo       String?             @map("reference_no")
  manualReferenceNo String?             @map("manual_reference_no")
  transactionDate   DateTime            @map("transaction_date")
  postedAt          DateTime?           @map("posted_at")
  postedBy          String?             @map("posted_by")
  remarks           String?             @map("remarks")
  createdAt         DateTime            @default(now()) @map("created_at")
  finalPostedAt     DateTime?           @map("final_posted_at")
  finalPostedBy     String?             @map("final_posted_by")
  projectId         String?             @map("project_id") @db.Char(36)
  updatedAt         DateTime            @default(now()) @map("updated_at")
  createdById       String?             @map("created_by") @db.Char(36)
  createdBy         User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)

  account AccountChart @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([projectId])
  @@index([transactionDate])
  @@index([batchStatus])
  @@map("temp_journal_transfer")
}

model DefaulSubheadSettings {
  settingsId String          @unique
  settings   String          @map("settings")
  subheadId  Int?            @map("subhead_id")
  subhead    AccountSubhead? @relation(fields: [subheadId], references: [id], onDelete: Restrict)

  @@index([settingsId])
  @@map("defaul_subhead_settings")
}

model DefaultAccountSettings {
  settingsId String        @unique
  settings   String        @map("settings")
  accountId  Int?          @map("account_id")
  account    AccountChart? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([settingsId])
  @@map("default_account_settings")
}

/// Explicit join table (replaces Prisma implicit `_BillingItemToConcessionDiscount`).

model AuditLog {
  id String @id @default(uuid())

  // Action details
  action     String // CREATE, UPDATE, DELETE, LOGIN, etc.
  entityType String // User, Invoice, Product, Payment
  entityId   String? // ID of affected record

  // User/System info
  performedById String?
  performedBy   User?   @relation(fields: [performedById], references: [id])

  // Changes
  oldValues Json?
  newValues Json?

  // Request metadata
  ipAddress String?
  userAgent String?
  requestId String?

  // Optional description
  description String?

  // Status
  status String? @default("SUCCESS")

  createdAt DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([performedById])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Cashier {
  id             String        @id @default(uuid()) @db.Char(36)
  name           String
  staffId        String?
  Staff          Staff?        @relation(fields: [staffId], references: [id])
  accountChartId Int?
  ledger         AccountChart? @relation(fields: [accountChartId], references: [id])
  status         Status
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])

  @@index([staffId])
  @@index([accountChartId])
  @@index([userId])
  @@map("cashiers")
}

model Department {
  id     String  @id @default(uuid()) @db.Char(36)
  name   String
  status Status  @default(Active)
  staff  Staff[]

  @@index([id])
  @@map("departments")
}

model GradeLevel {
  id               String           @id @default(uuid()) @db.Char(36)
  name             String
  status           Status           @default(Active)
  staff            Staff[]
  salaryCharts     SalaryChart[]
  payrollProcesses PayrollProcess[]

  @@index([id])
  @@map("grade_levels")
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

model SalaryComponent {
  id                            String                         @id @default(uuid()) @db.Char(36)
  name                          String                         @unique
  shortName                     String?                        @map("short_name")
  type                          SalaryComponentType
  status                        Status                         @default(Active)
  isTaxable                     Boolean                        @default(false) @map("is_taxable")
  isPensionable                 Boolean                        @default(false) @map("is_pensionable")
  isStatutory                   Boolean                        @default(false) @map("is_statutory")
  isFunction                    Boolean                        @default(false) @map("is_function")
  salaryCharts                  SalaryChart[]
  functionPercentage            Decimal?                       @map("function_percentage") @db.Decimal(14, 2)
  functionElements              Json?                          @map("function_elements") // array of strings representing the ids of the salary components that are part of the function
  accountId                     Int?                           @map("account_id")
  account                       AccountChart?                  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  rank                          Int                            @default(0) @map("rank")
  staffSalaryOverrideComponents StaffSalaryOverrideComponent[]
  payrollComponents             PayrollComponent[]
  isPrimary                     Boolean                        @default(false) @map("is_primary")

  @@map("salary_components")
}

model SalaryChart {
  id             String          @id @default(uuid()) @db.Char(36)
  gradeLevelId   String          @map("grade_level_id") @db.Char(36)
  gradeLevel     GradeLevel      @relation(fields: [gradeLevelId], references: [id])
  step           Int             @map("step")
  employmentType EmploymentType  @map("employment_type")
  componentId    String          @map("component_id") @db.Char(36)
  component      SalaryComponent @relation(fields: [componentId], references: [id])
  amount         Decimal         @map("amount") @db.Decimal(14, 2)
  status         Status          @default(Active)
  createdBy      String?         @map("created_by") @db.Char(36)
  createdByUser  User?           @relation("SalaryChartCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy      String?         @map("updated_by") @db.Char(36)
  updatedByUser  User?           @relation("SalaryChartUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([gradeLevelId, step, employmentType, componentId])
  @@index([gradeLevelId])
  @@index([componentId])
  @@index([employmentType])
  @@index([step])
  @@map("salary_charts")
}

model StaffSalaryOverrideComponent {
  id                          String                       @id @default(uuid()) @db.Char(36)
  staffId                     String                       @map("staff_id") @db.Char(36)
  staff                       Staff                        @relation(fields: [staffId], references: [id])
  componentId                 String                       @map("component_id") @db.Char(36)
  component                   SalaryComponent              @relation(fields: [componentId], references: [id])
  amount                      Decimal                      @map("amount") @db.Decimal(14, 2)
  isContinuous                Boolean                      @default(false) @map("is_continuous")
  targetAmount                Decimal?                     @map("target_amount") @db.Decimal(14, 2)
  createdBy                   String?                      @map("created_by") @db.Char(36)
  createdByUser               User?                        @relation("StaffSalaryOverrideCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  status                      Status                       @default(Active)
  staffSalaryProcessOverrides StaffSalaryProcessOverride[]

  @@index([staffId])
  @@index([componentId])
  @@map("staff_salary_override_components")
}

model StaffSalaryProcessOverride {
  id                             String                       @id @default(uuid()) @db.Char(36)
  staffSalaryOverrideComponentId String                       @map("staff_salary_override_component_id") @db.Char(36)
  staffSalaryOverrideComponent   StaffSalaryOverrideComponent @relation(fields: [staffSalaryOverrideComponentId], references: [id])
  amount                         Decimal                      @map("amount") @db.Decimal(14, 2)
  status                         Status                       @default(Active)
  year                           Int                          @map("year")
  month                          Int                          @map("month")
  createdAt                      DateTime                     @default(now()) @map("created_at")
  updatedAt                      DateTime                     @updatedAt @map("updated_at")

  @@map("staff_salary_process_overrides")
}

model PayrollProcess {
  id                String             @id @default(uuid()) @db.Char(36)
  staffId           String             @map("staff_id") @db.Char(36)
  staff             Staff              @relation(fields: [staffId], references: [id])
  year              Int                @map("year")
  month             Int                @map("month")
  gradeLevelId      String             @map("grade_level_id") @db.Char(36)
  gradeLevel        GradeLevel         @relation(fields: [gradeLevelId], references: [id])
  step              Int                @map("step")
  employmentType    EmploymentType     @map("employment_type")
  grossEarnings     Decimal            @default(0) @map("gross_earnings") @db.Decimal(14, 2)
  netAllowances     Decimal            @default(0) @map("net_allowances") @db.Decimal(14, 2)
  netEarnings       Decimal            @default(0) @map("net_earnings") @db.Decimal(14, 2)
  netDeductions     Decimal            @default(0) @map("deductions") @db.Decimal(14, 2)
  netPay            Decimal            @default(0) @map("net_pay") @db.Decimal(14, 2)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  payrollComponents PayrollComponent[]
  isPosted          Boolean            @default(false) @map("is_posted")
  isApproved        Boolean            @default(false) @map("is_approved")
  approvedAt        DateTime?          @map("approved_at")
  approvedBy        String?            @map("approved_by") @db.Char(36)
  approvedByUser    User?              @relation("PayrollProcessesApproved", fields: [approvedBy], references: [id], onDelete: SetNull)
  postedAt          DateTime?          @map("posted_at")
  postedBy          String?            @map("posted_by") @db.Char(36)
  postedByUser      User?              @relation("PayrollProcessesPosted", fields: [postedBy], references: [id], onDelete: SetNull)
  userId            String?            @map("user_id") @db.Char(36)
  user              User?              @relation("PayrollProcesses", fields: [userId], references: [id], onDelete: SetNull)
  remarks           String?            @map("remarks")

  @@index([staffId])
  @@index([gradeLevelId])
  @@index([step])
  @@index([employmentType])
  @@map("payroll_processes")
}

model PayrollComponent {
  id               String          @id @default(uuid()) @db.Char(36)
  payrollProcessId String          @map("payroll_process_id") @db.Char(36)
  payrollProcess   PayrollProcess  @relation(fields: [payrollProcessId], references: [id])
  componentId      String          @map("component_id") @db.Char(36)
  component        SalaryComponent @relation(fields: [componentId], references: [id])
  amount           Decimal         @default(0) @map("amount") @db.Decimal(14, 2)
  month            Int             @map("month")
  year             Int             @map("year")
  status           Status          @default(Active)
  isApproved       Boolean         @default(false) @map("is_approved")
  isPosted         Boolean         @default(false) @map("is_posted")

  @@index([payrollProcessId])
  @@index([componentId])
  @@map("payroll_components")
}

model ActivePayrollPeriod {
  id        String   @id @default(uuid()) @db.Char(36)
  year      Int      @map("year")
  month     Int      @map("month")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([year])
  @@index([month])
  @@map("active_payroll_period")
}

model AdministrativeExpenseComponent {
  id                     String                  @id @default(uuid()) @db.Char(36)
  name                   String                  @map("name")
  status                 Status                  @default(Active)
  accountId              Int?                    @map("account_id")
  account                AccountChart?           @relation(fields: [accountId], references: [id])
  administrativeExpenses AdministrativeExpense[]

  @@map("administrative_expense_components")
}

model AdministrativeExpense {
  id                               String                         @id @default(uuid()) @db.Char(36)
  status                           Status                         @default(Active)
  administrativeExpenseComponentId String                         @map("administrative_expense_category_id") @db.Char(36)
  administrativeExpenseComponent   AdministrativeExpenseComponent @relation(fields: [administrativeExpenseComponentId], references: [id], onDelete: Restrict)
  amount                           Decimal                        @map("amount") @db.Decimal(14, 2)
  transactionDate                  DateTime                       @map("transaction_date") @db.Date
  remarks                          String?                        @map("remarks")
  referenceNo                      String?                        @map("reference_no")
  createdAt                        DateTime                       @default(now()) @map("created_at")
  updatedAt                        DateTime                       @updatedAt @map("updated_at")
  createdById                      String?                        @map("created_by") @db.Char(36)
  createdBy                        User?                          @relation("AdministrativeExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById                      String?                        @map("updated_by") @db.Char(36)
  updatedBy                        User?                          @relation("AdministrativeExpenseUpdatedBy", fields: [updatedById], references: [id])

  @@map("administrative_expenses")
}

enum VehicleType {
  Car
  Bus
}

enum VehicleMake {
  Toyota
  Honda
  Nissan
  Suzuki
  Hyundai
  Kia
}

model Vehicle {
  id            String         @id @default(uuid()) @db.Char(36)
  vehicleNumber String         @map("vehicle_number") @db.VarChar(20)
  vehicleType   VehicleType    @default(Bus) @map("vehicle_type")
  vehicleMake   VehicleMake?   @map("vehicle_make")
  capacity      Int            @default(50) @map("capacity")
  driverId      String?        @map("driver_id") @db.Char(36)
  driver        Staff?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  status        Status         @default(Active) @map("status")
  remarks       String?        @db.Text
  createdById   String         @map("created_by") @db.Char(36)
  user          User?          @relation(fields: [userId], references: [id])
  userId        String?        @db.Char(36)

  @@unique([vehicleNumber])
  @@index([vehicleNumber])
  @@index([vehicleType])
  @@map("vehicles")
}
