  serviceCase ServiceCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([bookingId])
  @@index([caseId])
  @@map("booking_events")
}

model BookingReminder {
  id          String       @id @default(uuid()) @db.Char(36)
