  term                  Term                 @relation(fields: [termId], references: [id], onDelete: Restrict)
  assignmentComponentId String?              @map("assignment_component_id") @db.Char(36)
  assignmentComponent   AssessmentComponent? @relation(fields: [assignmentComponentId], references: [id], onDelete: SetNull)
  deadline              DateTime?            @map("deadline")
  status                AssignmentStatus     @default(Pending)
  createdById           String               @map("created_by") @db.Char(36)
  createdBy             User                 @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  attachments        AssignmentAttachment[]
  studentAssignments StudentAssignment[]

  @@index([classId])
  @@index([subjectId])
  @@index([sessionId])
  @@index([termId])
  @@index([assignmentComponentId])
  @@index([createdById])
  @@index([classId, subjectId, sessionId, termId])
  @@map("assignments")
}

model AssignmentAttachment {
  id           String     @id @default(uuid()) @db.Char(36)
  assignmentId String     @map("assignment_id") @db.Char(36)
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  url          String     @map("url") @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([assignmentId])
  @@map("assignment_attachments")
}

model StudentAssignment {
  id           String           @id @default(uuid()) @db.Char(36)
  assignmentId String           @map("assignment_id") @db.Char(36)
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  answer       String?          @map("answer") @db.Text
  studentId    String           @map("student_id") @db.Char(36)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  classId      String           @map("class_id") @db.Char(36)
  class        SchoolClass      @relation(fields: [classId], references: [id], onDelete: Restrict)
  subclassId   String?          @map("subclass_id") @db.Char(36)
  subclass     SubClass?        @relation(fields: [subclassId], references: [id], onDelete: SetNull)
  sessionId    String           @map("session_id") @db.Char(36)
  session      Session          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  termId       String           @map("term_id") @db.Char(36)
  term         Term             @relation(fields: [termId], references: [id], onDelete: Restrict)
  score        Decimal?         @map("score") @db.Decimal(8, 2)
  status       AssignmentStatus @default(Pending)
  submittedAt  DateTime?        @map("submitted_at")
  gradedAt     DateTime?        @map("graded_at")
  gradedBy     String?          @map("graded_by") @db.Char(36)
  gradedByUser User?            @relation(fields: [gradedBy], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  attachments StudentAssignmentAttachment[]

  @@unique([studentId, assignmentId, sessionId, termId])
  @@index([studentId])
  @@index([assignmentId])
  @@index([classId])
  @@index([subclassId])
  @@index([sessionId])
  @@index([termId])
  @@map("student_assignments")
}

model StudentAssignmentAttachment {
  id                  String            @id @default(uuid()) @db.Char(36)
  studentAssignmentId String            @map("student_assignment_id") @db.Char(36)
  studentAssignment   StudentAssignment @relation(fields: [studentAssignmentId], references: [id], onDelete: Cascade)
  url                 String            @map("url") @db.Text
  createdAt           DateTime          @default(now()) @map("created_at")

  @@index([studentAssignmentId])
  @@map("student_assignment_attachments")
}

model TeacherSubjects {
  id         String      @id @default(uuid()) @db.Char(36)
  staffId    String      @map("staff_id") @db.Char(36)
  staff      Staff       @relation(fields: [staffId], references: [id], onDelete: Restrict)
  subjectId  String      @map("subject_id") @db.Char(36)
  classId    String      @map("class_id") @db.Char(36)
  subclassId String?     @map("subclass_id") @db.Char(36)
  sessionId  String      @map("session_id") @db.Char(36)
  termId     String      @map("term_id") @db.Char(36)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @default(now()) @map("updated_at")
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  class      SchoolClass @relation(fields: [classId], references: [id], onDelete: Restrict)
  subclass   SubClass?   @relation(fields: [subclassId], references: [id], onDelete: SetNull)
  session    Session     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  term       Term        @relation(fields: [termId], references: [id], onDelete: Restrict)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?     @db.Char(36)

  @@unique([staffId, subjectId, classId, subclassId, sessionId, termId])
  @@index([staffId])
  @@index([subjectId])
  @@index([classId])
  @@index([subclassId])
  @@index([sessionId])
  @@index([termId])
  @@map("teacher_subjects")
}

model AttendanceRecord {
  id             String           @id @default(uuid()) @db.Char(36)
  sessionId      String           @map("session_id") @db.Char(36)
  session        Session          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  termId         String           @map("term_id") @db.Char(36)
  term           Term             @relation(fields: [termId], references: [id], onDelete: Restrict)
  studentId      String           @map("student_id") @db.Char(36)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  status         AttendanceStatus @default(Present)
  attendanceDate DateTime         @map("attendance_date") @db.Date
  checkInTime    DateTime         @map("check_in_time")
  checkOutTime   DateTime?        @map("check_out_time")
  markedById     String           @map("marked_by") @db.Char(36)
  markedBy       User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)
  latitude       Decimal?         @db.Decimal(10, 8)
  longitude      Decimal?         @db.Decimal(11, 8)
  remarks        String?          @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")

  @@unique([studentId, attendanceDate])
  @@index([sessionId])
  @@index([termId])
  @@index([studentId])
  @@index([markedById])
  @@index([attendanceDate])
  @@map("attendance_records")
}

enum VehicleType {
  Car
  Bus
}

enum VehicleMake {
  Toyota
  Honda
  Nissan
  Suzuki
  Hyundai
  Kia
}

model Vehicle {
  id            String         @id @default(uuid()) @db.Char(36)
  vehicleNumber String         @map("vehicle_number") @db.VarChar(20)
  vehicleType   VehicleType    @default(Bus) @map("vehicle_type")
  vehicleMake   VehicleMake?   @map("vehicle_make")
  capacity      Int            @default(50) @map("capacity")
  driverId      String?        @map("driver_id") @db.Char(36)
  driver        Staff?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  status        Status         @default(Active) @map("status")
  remarks       String?        @db.Text
  createdById   String         @map("created_by") @db.Char(36)
  user          User?          @relation(fields: [userId], references: [id])
  userId        String?        @db.Char(36)
  vehicleRoutes VehicleRoute[]
  vehicleTrips  VehicleTrip[]

  @@unique([vehicleNumber])
  @@index([vehicleNumber])
  @@index([vehicleType])
  @@map("vehicles")
}

model VehicleRoute {
  id        String   @id @default(uuid()) @db.Char(36)
  vehicleId String   @map("vehicle_id") @db.Char(36)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  routeId   String   @map("route_id") @db.Char(36)
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([vehicleId, routeId])
  @@index([vehicleId])
  @@index([routeId])
  @@map("vehicle_routes")
}

model Route {
  id   String @id @default(uuid()) @db.Char(36)
  name String @map("name") @db.VarChar(50)

  description       String?            @map("description") @db.Text
  homeToSchoolCost  Decimal?           @default(0) @map("home_to_school_cost") @db.Decimal(12, 2)
  schoolToHomeCost  Decimal?           @default(0) @map("school_to_home_cost") @db.Decimal(12, 2)
  roundTripCost     Decimal?           @default(0) @map("round_trip_cost") @db.Decimal(12, 2)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  vehicleRoutes     VehicleRoute[]
  routeBustops      RouteBustop[]
  vehicleTripRoutes VehicleTripRoute[]
  studentTransports StudentTransport[]
  status            Status             @default(Active) @map("status")

  @@unique([name])
  @@index([name])
  @@map("routes")
}

model Bustop {
  id                             String                          @id @default(uuid()) @db.Char(36)
  name                           String                          @map("name") @db.VarChar(100)
  description                    String?                         @map("description") @db.Text
  latitude                       Decimal?                        @db.Decimal(10, 8)
  longitude                      Decimal?                        @db.Decimal(11, 8)
  status                         Status                          @default(Active)
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  routeBustops                   RouteBustop[]
  studentTransports              StudentTransport[]
  studentTransportationRegisters StudentTransportationRegister[]

  @@unique([name])
  @@index([name])
  @@index([status])
  @@map("bustops")
}

model RouteBustop {
  id        String   @id @default(uuid()) @db.Char(36)
  routeId   String   @map("route_id") @db.Char(36)
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Restrict)
  bustopId  String   @map("bustop_id") @db.Char(36)
  bustop    Bustop   @relation(fields: [bustopId], references: [id], onDelete: Restrict)
  stopOrder Int      @default(0) @map("stop_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([routeId, bustopId])
  @@index([routeId])
  @@index([bustopId])
  @@map("route_bustops")
}

model VehicleTrip {
  id                             String                          @id @default(uuid()) @db.Char(36)
  label                          String?                         @map("label") @db.VarChar(100)
  vehicleId                      String                          @map("vehicle_id") @db.Char(36)
  vehicle                        Vehicle                         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driverId                       String                          @map("driver_id") @db.Char(36)
  driver                         Staff                           @relation(fields: [driverId], references: [id], onDelete: Restrict)
  startTime                      DateTime?                       @map("start_time")
  endTime                        DateTime?                       @map("end_time")
  latitude                       Decimal?                        @db.Decimal(10, 8)
  longitude                      Decimal?                        @db.Decimal(11, 8)
  tripDirection                  Direction                       @default(HomeToSchool) @map("trip_direction")
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  vehicleTripRoutes              VehicleTripRoute[]
  studentTransportationRegisters StudentTransportationRegister[]
  status                         VehicleTripStatus               @default(Pending) @map("status")
  tripSupportStaffs              TripSupportStaff[]

  @@index([vehicleId])
  @@index([driverId])
  @@index([startTime])
  @@index([status])
  @@map("vehicle_trips")
}

model VehicleTripRoute {
  id            String      @id @default(uuid()) @db.Char(36)
  vehicleTripId String      @map("vehicle_trip_id") @db.Char(36)
  vehicleTrip   VehicleTrip @relation(fields: [vehicleTripId], references: [id], onDelete: Cascade)
  routeId       String      @map("route_id") @db.Char(36)
  route         Route       @relation(fields: [routeId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([vehicleTripId, routeId])
  @@index([vehicleTripId])
  @@index([routeId])
  @@map("vehicle_trip_routes")
}

enum VehicleTripStatus {
  Pending
  InProgress
  Completed
  Cancelled
}

enum TransportSubscriptionType {
  RoundTrip
  OneWaySchool
  OneWayHome
}

model StudentTransport {
  id               String                    @id @default(uuid()) @db.Char(36)
  studentId        String                    @map("student_id") @db.Char(36)
  student          Student                   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  routeId          String                    @map("route_id") @db.Char(36)
  route            Route                     @relation(fields: [routeId], references: [id], onDelete: Restrict)
  bustopId         String                    @map("bustop_id") @db.Char(36)
  bustop           Bustop                    @relation(fields: [bustopId], references: [id], onDelete: Restrict)
  status           Status                    @default(Active)
  subscriptionType TransportSubscriptionType @default(RoundTrip) @map("subscription_type")
  sessionId        String                    @map("session_id") @db.Char(36)
  session          Session                   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  termId           String                    @map("term_id") @db.Char(36)
  term             Term                      @relation(fields: [termId], references: [id], onDelete: Restrict)
  classId          String                    @map("class_id") @db.Char(36)
  class            SchoolClass               @relation(fields: [classId], references: [id], onDelete: Restrict)
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  @@unique([studentId, sessionId, termId])
  @@index([routeId])
  @@index([bustopId])
  @@index([status])
  @@map("student_transports")
}

enum Direction {
  HomeToSchool
  SchoolToHome
}

enum StudentTransportationRegisterStatus {
  Boarding
  OnTransit
  DroppedOff
}

model StudentTransportationRegister {
  id              String                              @id @default(uuid()) @db.Char(36)
  studentId       String                              @map("student_id") @db.Char(36)
  student         Student                             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  nearestBustopId String                              @map("nearest_bustop_id") @db.Char(36)
  bustop          Bustop                              @relation(fields: [nearestBustopId], references: [id], onDelete: Restrict)
  vehicleTripId   String                              @map("vehicle_trip_id") @db.Char(36)
  vehicleTrip     VehicleTrip                         @relation(fields: [vehicleTripId], references: [id], onDelete: Restrict)
  startTime       DateTime?                           @map("start_time")
  endTime         DateTime?                           @map("end_time")
  direction       Direction                           @default(HomeToSchool) @map("direction")
  status          StudentTransportationRegisterStatus @default(Boarding) @map("status")
  createdAt       DateTime                            @default(now()) @map("created_at")
  updatedAt       DateTime                            @updatedAt @map("updated_at")

  pickUpLatitude   Decimal? @map("pick_up_latitude") @db.Decimal(10, 8)
  pickUpLongitude  Decimal? @map("pick_up_longitude") @db.Decimal(11, 8)
  dropOffLatitude  Decimal? @map("drop_off_latitude") @db.Decimal(10, 8)
  dropOffLongitude Decimal? @map("drop_off_longitude") @db.Decimal(11, 8)

  @@unique([studentId, vehicleTripId])
  @@index([studentId])
  @@index([nearestBustopId])
  @@index([vehicleTripId])
  @@index([startTime])
  @@map("student_transportation_registers")
}

model TripSupportStaff {
  id            String      @id @default(uuid()) @db.Char(36)
  staffId       String      @map("staff_id") @db.Char(36)
  staff         Staff       @relation(fields: [staffId], references: [id], onDelete: Restrict)
  vehicleTripId String      @map("vehicle_trip_id") @db.Char(36)
  vehicleTrip   VehicleTrip @relation(fields: [vehicleTripId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([staffId, vehicleTripId])
  @@index([vehicleTripId])
  @@map("trip_support_staffs")
}
