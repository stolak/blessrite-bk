// datasource db {
// provider = "postgresql"
// url      = env("DATABASE_URL")
// }

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

// datasource db {
//   provider = "postgresql"
//   url      = env("DATABASE_URL")
// }

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserType {
  SuperAdmin
  Staff
  Student
  Parent
}

enum Status {
  Active
  Inactive
  Archived
}

enum JournalTransferType {
  Debit
  Credit
}

enum BatchStatus {
  Pending
  Processed
  Failed
}

enum InventoryCategoryType {
  Consumable
  NonConsumable
}

model Privilege {
  id           String               @id @default(uuid()) @db.Char(36)
  name         String               @unique
  description  String?
  userLinks    PrivilegeToUser[]
  appRoleLinks AppRoleToPrivilege[]

  @@map("privileges")
}

model User {
  id              String   @id @default(uuid()) @db.Char(36)
  password        String
  firstName       String?
  lastName        String?
  profileImageUrl String?
  phoneNumber     String?
  email           String   @unique
  userType        UserType @default(Staff)
  isActive        Boolean  @default(false)
  isVerified      Boolean  @default(false)
  isEmailVerified Boolean  @default(false)
  isPhoneVerified Boolean  @default(false)
  isDeleted       Boolean  @default(false)

  createdById  String? @db.Char(36)
  approvedById String? @db.Char(36)
  modifiedById String? @db.Char(36)

  createdBy  User? @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User? @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  modifiedBy User? @relation("ModifiedBy", fields: [modifiedById], references: [id], onDelete: SetNull)

  createdUsers  User[] @relation("CreatedBy")
  approvedUsers User[] @relation("ApprovedBy")
  modifiedUsers User[] @relation("ModifiedBy")

  status       String   @default("active")
  referralCode String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Password reset tokens
  passwordResetTokens PasswordResetToken[]

  // Inventory/School domain relations
  userRoles                     UserRole[]
  createdInventoryItems         InventoryItem[]        @relation("InventoryItemCreatedBy")
  createdSuppliers              Supplier[]             @relation("SupplierCreatedBy")
  createdSchoolClasses          SchoolClass[]          @relation("SchoolClassCreatedBy")
  createdStudents               Student[]              @relation("StudentCreatedBy")
  createdStaff                  Staff[]                @relation("StaffCreatedBy")
  inventoryTransactionsReceived InventoryTransaction[] @relation("InventoryTransactionReceiver")
  createdInventoryTransactions  InventoryTransaction[] @relation("InventoryTransactionCreatedBy")
  staffProfile                  Staff?                 @relation("StaffUser")

  createdProjects               Project[]                      @relation("ProjectCreatedBy")
  managedStores                 Store[]                        @relation("StoreManager")
  createdFacility               Facility[]                     @relation("FacilityCreatedBy")
  /**
   * Stores this user is granted access to (many-to-many; separate from primary manager role).
   */
  storeAccesses                 UserStore[]
  tempJournalTransfers          TempJournalTransfer[]
  studentJournalTransfers       StudentJournalTransfer[]
  inventoryTransactions         InventoryTransaction[]
  privilegeLinks                PrivilegeToUser[]
  auditLogs                     AuditLog[]
  cashiers                      Cashier[]
  staffJournalTransfers         StaffJournalTransfer[]
  salaryChartsCreated           SalaryChart[]                  @relation("SalaryChartCreatedBy")
  salaryChartsUpdated           SalaryChart[]                  @relation("SalaryChartUpdatedBy")
  staffSalaryOverrideComponents StaffSalaryOverrideComponent[] @relation("StaffSalaryOverrideCreatedBy")
  payrollProcesses              PayrollProcess[]               @relation("PayrollProcesses")
  payrollProcessesApproved      PayrollProcess[]               @relation("PayrollProcessesApproved")
  payrollProcessesPosted        PayrollProcess[]               @relation("PayrollProcessesPosted")
  administrativeExpensesCreated AdministrativeExpense[]        @relation("AdministrativeExpenseCreatedBy")
  administrativeExpensesUpdated AdministrativeExpense[]        @relation("AdministrativeExpenseUpdatedBy")
  createdAssignments            Assignment[]                   @relation("AssignmentCreatedBy")
  studentAssignments            StudentAssignment[]
  students                      Student[]
  teacherSubjects               TeacherSubjects[]
  attendanceRecordsMarked       AttendanceRecord[]             @relation("AttendanceMarkedBy")
  vehicles                      Vehicle[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Bank {
  id               String             @id @default(uuid()) @db.Char(36)
  bankCode         String             @unique
  bankName         String
  staffBankDetails StaffBankDetails[]

  @@map("banks")
}

enum RecordStatus {
  active
  inactive
  archived
}

enum StudentStatus {
  Active
  Inactive
  Graduated
  Transferred
  Suspended
  Archived
}

enum Gender {
  male
  female
  other
}

enum InventoryTransactionType {
  purchase
  donation
  student_purchase

  student_collection
  hostel_collection
  departmental_collection
  staff_collection
  project_collection
  facility_collection

  student_return
  hostel_return
  departmental_return
  staff_return
  facility_return
  sales
  disposal
  store_transfer
}

enum InventoryTransactionStatus {
  pending
  cancelled
  deleted
  completed
}

enum StaffPosition {
  class_teacher
  assistant_teacher
  subject_teacher
  principal
  vice_principal
  teacher
  admin
  other
}

model Category {
  id                  String                @id @default(uuid()) @db.Char(36)
  name                String                @unique
  description         String?
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @default(now()) @map("updated_at")
  status              Status                @default(Active)
  categoryType        InventoryCategoryType @default(Consumable)
  consumableAccountId Int?                  @map("consumable_account_id")
  consumableAccount   AccountChart?         @relation("CategoryConsumableAccount", fields: [consumableAccountId], references: [id])
  subCategories       SubCategory[]
  inventoryItems      InventoryItem[]
  assetAccountId      Int?                  @map("asset_account_id")
  assetAccount        AccountChart?         @relation("CategoryAssetAccount", fields: [assetAccountId], references: [id])

  @@map("categories")
}

/// Named `AppRole` to avoid colliding with your existing `Role` enum.
model AppRole {
  id     String @id @default(uuid()) @db.Char(36)
  name   String
  status String @default("active")

  roleMenus      RoleMenu[]
  userRoles      UserRole[]
  privilegeLinks AppRoleToPrivilege[]

  @@map("roles")
}

/// Explicit join table (replaces Prisma implicit `_PrivilegeToUser`).
model PrivilegeToUser {
  privilegeId String    @map("privilege_id") @db.Char(36)
  privilege   Privilege @relation(fields: [privilegeId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id") @db.Char(36)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([privilegeId, userId])
  @@index([userId])
  @@map("_privilege_to_user")
}

/// Explicit join table (replaces Prisma implicit `_AppRoleToPrivilege`).
model AppRoleToPrivilege {
  appRoleId   String    @map("app_role_id") @db.Char(36)
  appRole     AppRole   @relation(fields: [appRoleId], references: [id], onDelete: Cascade)
  privilegeId String    @map("privilege_id") @db.Char(36)
  privilege   Privilege @relation(fields: [privilegeId], references: [id], onDelete: Cascade)

  @@id([appRoleId, privilegeId])
  @@index([privilegeId])
  @@map("_app_role_to_privilege")
}

model Menu {
  id            String         @id @default(uuid()) @db.Char(36)
  route         String         @unique
  caption       String
  status        Status         @default(Active)
  roleMenus     RoleMenu[]
  menuChildrens MenuChildren[]

  @@map("menus")
}

model MenuChildren {
  id        String   @id @default(uuid()) @db.Char(36)
  menuId    String   @map("menu_id") @db.Char(36)
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name      String
  route     String
  status    Status   @default(Active)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  /// Per-role grants for this child under a parent RoleMenu assignment.
  roleMenuChildren RoleMenuChild[]

  @@index([menuId])
  @@map("menu_children")
}

model RoleMenu {
  id     String @id @default(uuid()) @db.Char(36)
  roleId String @map("role_id") @db.VarChar(50)
  menuId String @map("menu_id") @db.Char(36)

  menu Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  role AppRole? @relation(fields: [roleId], references: [id])

  /// Selected child routes under this role+parent menu. Empty = all active children.
  roleMenuChildren RoleMenuChild[]

  @@unique([roleId, menuId])
  @@index([roleId])
  @@index([menuId])
  @@map("role_menus")
}

/// Grants a role access to specific child items under an assigned parent menu (RoleMenu).
/// A row links one RoleMenu assignment to one MenuChildren entry.
/// Resolution: if no rows exist for a RoleMenu, the role sees all active MenuChildren of that menu;
/// if one or more rows exist, only those children are visible (whitelist).
model RoleMenuChild {
  id          String @id @default(uuid()) @db.Char(36)
  roleMenuId  String @map("role_menu_id") @db.Char(36)
  menuChildId String @map("menu_child_id") @db.Char(36)

  roleMenu  RoleMenu     @relation(fields: [roleMenuId], references: [id], onDelete: Cascade)
  menuChild MenuChildren @relation(fields: [menuChildId], references: [id], onDelete: Cascade)

  @@unique([roleMenuId, menuChildId])
  @@index([roleMenuId])
  @@index([menuChildId])
  @@map("role_menu_children")
}

model UserRole {
  userId String @id @map("user_id") @db.Char(36)
  roleId String @map("role_id") @db.Char(36)

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@map("user_roles")
}

model SubCategory {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String
  description String?
  categoryId  String?  @map("category_id") @db.Char(36)
  status      Status   @default(Active)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventoryItems InventoryItem[]

  @@unique([name, categoryId])
  @@index([categoryId])
  @@map("sub_categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique
  status    Status   @default(Active)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  inventoryItems InventoryItem[]

  @@map("brands")
}

model Uom {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique
  symbol    String   @unique
  status    Status   @default(Active)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  inventoryItems InventoryItem[]

  @@map("uoms")
}

model InventoryItem {
  id                String   @id @default(uuid()) @db.Char(36)
  sku               String?  @unique
  name              String   @unique
  categoryId        String?  @map("category_id") @db.Char(36)
  subCategoryId     String?  @map("sub_category_id") @db.Char(36)
  brandId           String?  @map("brand_id") @db.Char(36)
  uomId             String?  @map("uom_id") @db.Char(36)
  barcode           String?  @unique
  costPrice         Decimal  @map("cost_price") @db.Decimal(12, 2)
  sellingPrice      Decimal  @map("selling_price") @db.Decimal(12, 2)
  lowStockThreshold Int      @default(0) @map("low_stock_threshold")
  createdById       String?  @map("created_by") @db.Char(36)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategory           SubCategory?           @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  brand                 Brand?                 @relation(fields: [brandId], references: [id], onDelete: Restrict)
  uom                   Uom?                   @relation(fields: [uomId], references: [id], onDelete: Restrict)
  createdBy             User?                  @relation("InventoryItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  status                Status                 @default(Active)
  inventoryTransactions InventoryTransaction[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([brandId])
  @@index([uomId])
  @@index([createdById])
  @@map("inventory_items")
}

model Supplier {
  id                    String                 @id @default(uuid()) @db.Char(36)
  name                  String                 @unique
  contactName           String?                @map("contact_name")
  email                 String?
  phone                 String?
  address               String?
  city                  String?
  state                 String?
  country               String?
  website               String?
  notes                 String?
  status                Status                 @default(Active)
  createdById           String?                @map("created_by") @db.Char(36)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @default(now()) @map("updated_at")
  // accountId             Int?                   @map("account_id")
  // account               AccountChart?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy             User?                  @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  inventoryTransactions InventoryTransaction[]

  @@index([createdById])
  @@map("suppliers")
}

model SchoolClass {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique
  status      Status    @default(Active)
  createdById String    @map("created_by") @db.Char(36)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")
  createdBy   User      @relation("SchoolClassCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  students    Student[]

  subClasses                         SubClass[]
  classAssessmentTemplates           ClassAssessmentTemplate[]
  classSubjects                      ClassSubject[]
  studentSubjectRegistrations        StudentSubjectRegistration[]
  studentAssessmentScores            StudentAssessmentScore[]
  studentBehaviouralAssessmentScores StudentBehaviouralAssessmentScore[]
  assessmentRemarks                  AssessmentRemarks[]
  defaultClassRemarkSetups           DefaultClassRemarkSetup[]
  assignments                        Assignment[]
  studentAssignments                 StudentAssignment[]
  teacherSubjects                    TeacherSubjects[]
  studentTransports                  StudentTransport[]

  @@index([createdById])
  @@map("school_classes")
}

model SubClass {
  id                                 String                              @id @default(uuid()) @db.Char(36)
  name                               String
  status                             Status                              @default(Active)
  createdAt                          DateTime                            @default(now()) @map("created_at")
  updatedAt                          DateTime                            @default(now()) @map("updated_at")
  class                              SchoolClass?                        @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId                            String?                             @map("class_id") @db.Char(36)
  students                           Student[]
  inventoryTransactions              InventoryTransaction[]
  classSubjects                      ClassSubject[]
  studentSubjectRegistrations        StudentSubjectRegistration[]
  studentAssessmentScores            StudentAssessmentScore[]
  studentBehaviouralAssessmentScores StudentBehaviouralAssessmentScore[]
  studentAssignments                 StudentAssignment[]
  teacherSubjects                    TeacherSubjects[]

  @@unique([name, classId])
  @@index([classId])
  @@map("sub_classes")
}

model Hostel {
  id                    String                 @id @default(uuid()) @db.Char(36)
  name                  String                 @unique
  status                Status                 @default(Active)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @default(now()) @map("updated_at")
  hostelRooms           HostelRoom[]
  inventoryTransactions InventoryTransaction[]

  @@map("hostels")
}

model HostelRoom {
  id                    String                 @id @default(uuid()) @db.Char(36)
  name                  String                 @unique
  hostelId              String                 @map("hostel_id") @db.Char(36)
  hostel                Hostel                 @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  status                Status                 @default(Active)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @default(now()) @map("updated_at")
  inventoryTransactions InventoryTransaction[]

  @@map("hostel_rooms")
}

model Student {
  id              String        @id @default(uuid()) @db.Char(36)
  admissionNumber String        @unique @map("admission_number")
  firstName       String        @map("first_name")
  middleName      String?       @map("middle_name")
  lastName        String        @map("last_name")
  studentEmail    String?       @unique @map("student_email")
  gender          Gender
  dateOfBirth     DateTime      @map("date_of_birth") @db.Date
  classId         String?       @map("class_id") @db.Char(36)
  guardianName    String?       @map("guardian_name")
  guardianEmail   String?       @map("guardian_email")
  guardianContact String?       @map("guardian_contact")
  address         String?
  status          StudentStatus @default(Active)
  imageUrl        String?       @map("image_url")

  accountId   Int?          @map("account_id")
  account     AccountChart? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdById String        @map("created_by") @db.Char(36)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @map("updated_at")
  userId      String?       @map("user_id") @db.Char(36)
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  class       SchoolClass?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  createdBy   User          @relation("StudentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  subClass                           SubClass?                           @relation(fields: [subClassId], references: [id])
  subClassId                         String?                             @db.Char(36)
  inventoryTransactions              InventoryTransaction[]
  studentBillings                    StudentBilling[]
  studentJournalTransfers            StudentJournalTransfer[]
  studentSubjectRegistrations        StudentSubjectRegistration[]
  studentAssessmentScores            StudentAssessmentScore[]
  studentBehaviouralAssessmentScores StudentBehaviouralAssessmentScore[]
  assessmentRemarks                  AssessmentRemarks[]
  studentAssignments                 StudentAssignment[]
  attendanceRecords                  AttendanceRecord[]
  studentTransports                  StudentTransport[]
  studentTransportationRegisters     StudentTransportationRegister[]

  @@index([classId])
  @@index([createdById])
  @@index([status, classId, subClassId])
  @@map("students")
}

model Term {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String
  status    Status   @default(Active)
  createdAt DateTime @default(now()) @map("created_at")

  activePeriods                      ActivePeriod[]
  inventoryTransactions              InventoryTransaction[]
  defaultBillingPeriods              DefaultBillingPeriod[]
  classAssessmentTemplates           ClassAssessmentTemplate[]
  studentSubjectRegistrations        StudentSubjectRegistration[]
  studentAssessmentScores            StudentAssessmentScore[]
  classSubjects                      ClassSubject[]
  studentBehaviouralAssessmentScores StudentBehaviouralAssessmentScore[]
  assessmentRemarks                  AssessmentRemarks[]
  assignments                        Assignment[]
  studentAssignments                 StudentAssignment[]
  teacherSubjects                    TeacherSubjects[]
  attendanceRecords                  AttendanceRecord[]
  studentTransports                  StudentTransport[]

  @@unique([name])
  @@map("terms")
}

model Session {
  id                                 String                              @id @default(uuid()) @db.Char(36)
  name                               String                              @unique
  status                             Status                              @default(Active)
  createdAt                          DateTime                            @default(now()) @map("created_at")
  activePeriods                      ActivePeriod[]
  inventoryTransactions              InventoryTransaction[]
  defaultBillingPeriods              DefaultBillingPeriod[]
  classAssessmentTemplates           ClassAssessmentTemplate[]
  classSubjects                      ClassSubject[]
  studentSubjectRegistrations        StudentSubjectRegistration[]
  studentAssessmentScores            StudentAssessmentScore[]
  studentBehaviouralAssessmentScores StudentBehaviouralAssessmentScore[]
  assessmentRemarks                  AssessmentRemarks[]
  assignments                        Assignment[]
  studentAssignments                 StudentAssignment[]
  teacherSubjects                    TeacherSubjects[]
  attendanceRecords                  AttendanceRecord[]
  studentTransports                  StudentTransport[]

  @@map("sessions")
}

model ActivePeriod {
  id        String   @id @default(uuid()) @db.Char(36)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  sessionId String   @map("session_id") @db.Char(36)
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  termId    String   @map("term_id") @db.Char(36)
  term      Term     @relation(fields: [termId], references: [id], onDelete: Restrict)
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("active_period")
}

model DefaultBillingPeriod {
  id        String   @id @default(uuid()) @db.Char(36)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  sessionId String   @map("session_id") @db.Char(36)
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  termId    String   @map("term_id") @db.Char(36)
  term      Term     @relation(fields: [termId], references: [id], onDelete: Restrict)
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("default_billing_period")
}

enum EmploymentType {
  Permanent
  Contractual
  Casual
  Internship
  Volunteer
  PartTime
  Temporary
  Seasonal
  ProjectBased
  Other
}

model Staff {
  id                            String                         @id @default(uuid()) @db.Char(36)
  StaffNumber                   String                         @unique @map("staff_number") @db.VarChar(50)
  email                         String                         @unique
  name                          String
  position                      StaffPosition                  @default(teacher)
  employmentType                EmploymentType                 @default(Permanent)
  status                        Status                         @default(Active)
  profileImageUrl               String?                        @map("profile_image_url")
  createdById                   String                         @map("created_by") @db.Char(36)
  createdAt                     DateTime                       @default(now()) @map("created_at")
  updatedAt                     DateTime                       @default(now()) @map("updated_at")
  gradeLevelId                  String?                        @map("grade_level_id") @db.Char(36)
  gradeLevel                    GradeLevel?                    @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  step                          Int                            @default(0) @map("step")
  salary                        Decimal                        @default(0) @map("salary") @db.Decimal(12, 2)
  createdBy                     User                           @relation("StaffCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  departmentId                  String?                        @map("department_id") @db.Char(36)
  department                    Department?                    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  userId                        String?                        @unique @db.Char(36)
  user                          User?                          @relation("StaffUser", fields: [userId], references: [id], onDelete: SetNull)
  inventoryTransactions         InventoryTransaction[]
  cashiers                      Cashier[]
  staffBankDetails              StaffBankDetails[]
  dateOfBirth                   DateTime?                      @map("date_of_birth") @db.Date
  dateOfAppointment             DateTime?                      @map("date_of_appointment") @db.Date
  dateOfResignation             DateTime?                      @map("date_of_resignation") @db.Date
  dateOfTermination             DateTime?                      @map("date_of_termination") @db.Date
  staffJournalTransfers         StaffJournalTransfer[]
  staffSalaryOverrideComponents StaffSalaryOverrideComponent[]
  payrollProcesses              PayrollProcess[]
  teacherSubjects               TeacherSubjects[]
  vehicles                      Vehicle[]
  vehicleTrips                  VehicleTrip[]
  tripSupportStaffs             TripSupportStaff[]

  @@index([userId])
  @@index([StaffNumber])
  @@index([createdById])
  @@map("staffs")
}

model InventoryTransaction {
  id               String                     @id @default(uuid()) @db.Char(36)
  itemId           String                     @map("item_id") @db.Char(36)
  supplierId       String?                    @map("supplier_id") @db.Char(36)
  receiverId       String?                    @map("receiver_id") @db.Char(36)
  supplierReceiver String?                    @map("supplier_receiver")
  transactionType  InventoryTransactionType   @map("transaction_type")
  qtyIn            Decimal                    @default(0) @map("qty_in") @db.Decimal(12, 2)
  inCost           Decimal                    @default(0) @map("in_cost") @db.Decimal(12, 2)
  qtyOut           Decimal                    @default(0) @map("qty_out") @db.Decimal(12, 2)
  outCost          Decimal                    @default(0) @map("out_cost") @db.Decimal(12, 2)
  amountPaid       Decimal                    @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status           InventoryTransactionStatus @default(pending)
  referenceNo      String?                    @map("reference_no")
  notes            String?
  studentId        String?                    @map("student_id") @db.Char(36)
  student          Student?                   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  classId          String?                    @map("class_id") @db.Char(36)
  sessionId        String?                    @map("session_id") @db.Char(36)
  session          Session?                   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  termId           String?                    @map("term_id") @db.Char(36)
  term             Term?                      @relation(fields: [termId], references: [id], onDelete: SetNull)
  subclassId       String?                    @map("subclass_id") @db.Char(36)
  subclass         SubClass?                  @relation(fields: [subclassId], references: [id], onDelete: SetNull)
  staffId          String?                    @map("staff_id") @db.Char(36)
  staff            Staff?                     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  transactionDate  DateTime                   @default(now()) @map("transaction_date")
  createdById      String                     @map("created_by") @db.Char(36)
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @default(now()) @map("updated_at")

  item               InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  supplier           Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  receiver           User?         @relation("InventoryTransactionReceiver", fields: [receiverId], references: [id], onDelete: SetNull)
  createdBy          User          @relation("InventoryTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  project            Project?      @relation("ProjectTransactions", fields: [projectId], references: [id])
  projectId          String?       @db.Char(36)
  hostelRoomId       String?       @map("hostel_room_id") @db.Char(36)
  hostelRoom         HostelRoom?   @relation(fields: [hostelRoomId], references: [id], onDelete: SetNull)
  hostelId           String?       @map("hostel_id") @db.Char(36)
  hostel             Hostel?       @relation(fields: [hostelId], references: [id], onDelete: SetNull)
  storeId            String?       @map("store_id") @db.Char(36)
  store              Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  facilityId         String?       @map("facility_id") @db.Char(36)
  facility           Facility?     @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  isAcknowledged     Boolean       @default(false) @map("is_acknowledged")
  acknowledgedAt     DateTime?     @map("acknowledged_at") @db.DateTime
  acknowledgedBy     String?       @map("acknowledged_by") @db.Char(36)
  acknowledgedByUser User?         @relation(fields: [acknowledgedBy], references: [id], onDelete: SetNull)
  customerMame       String?       @map("customer_name")

  @@index([itemId])
  @@index([supplierId])
  @@index([receiverId])
  @@index([createdById])
  @@index([facilityId])
  @@index([projectId])
  @@map("inventory_transactions")
}

model Project {
  id                      String                   @id @default(uuid()) @db.Char(36)
  name                    String
  description             String?
  status                  Status                   @default(Active)
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @default(now()) @map("updated_at")
  inventoryTransactions   InventoryTransaction[]   @relation("ProjectTransactions")
  accountTransactions     AccountTransaction[]
  tempJournalTransfers    TempJournalTransfer[]
  CreatedBy               User?                    @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdById             String?                  @map("created_by") @db.Char(36)
  studentJournalTransfers StudentJournalTransfer[]

  @@map("projects")
}

model Facility {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String
  description String?
  status      Status   @default(Active)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  createdById String?  @map("created_by") @db.Char(36)
  CreatedBy   User?    @relation("FacilityCreatedBy", fields: [createdById], references: [id])

  inventoryTransactions InventoryTransaction[]

  @@index([createdById])
  @@map("facilities")
}

model Store {
  id                    String                 @id @default(uuid()) @db.Char(36)
  name                  String                 @unique
  description           String?
  status                Status                 @default(Active)
  managerId             String?                @map("manager_id") @db.Char(36)
  manager               User?                  @relation("StoreManager", fields: [managerId], references: [id])
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @default(now()) @map("updated_at")
  inventoryTransactions InventoryTransaction[]
  /**
   * Users granted access to this store (many-to-many).
   */
  userAccesses          UserStore[]

  @@map("stores")
}

/// Join table: which users may access which stores (M:N). Distinct from `Store.managerId` (primary manager).
model UserStore {
  userId    String   @map("user_id") @db.Char(36)
  storeId   String   @map("store_id") @db.Char(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, storeId])
  @@index([storeId])
  @@map("user_stores")
}

/// Chart of accounts: top-level group (e.g. Assets, Liabilities).
model AccountGroup {
  id   Int    @id @default(autoincrement())
  name String @map("name")
  rank Int

  heads               AccountHead[]
  subHeads            AccountSubhead[]
  accountCharts       AccountChart[]
  accountTransactions AccountTransaction[]

  @@map("account_groups")
}

/// Account head under a group (e.g. Cash, Bank).
model AccountHead {
  id      Int    @id @default(autoincrement())
  groupId Int    @map("group_id")
  code    String @map("code")
  name    String @map("name")
  rank    Int

  group               AccountGroup         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  subHeads            AccountSubhead[]
  accountCharts       AccountChart[]
  accountTransactions AccountTransaction[]

  @@index([groupId])
  @@map("account_heads")
}

enum AccountType {
  Cash
  NonCash
}

/// Subhead under a head (detailed ledger line).
model AccountSubhead {
  id            Int         @id @default(autoincrement())
  groupId       Int         @map("group_id")
  headId        Int         @map("head_id")
  code          String?     @map("code")
  name          String      @map("name")
  status        Status      @default(Active)
  rank          Int
  afs           String?     @map("afs")
  paymentMethod String?     @map("payment_method")
  accountType   AccountType @default(NonCash) @map("account_type")

  group                 AccountGroup            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  head                  AccountHead             @relation(fields: [headId], references: [id], onDelete: Restrict)
  accountCharts         AccountChart[]
  accountTransactions   AccountTransaction[]
  defaulSubheadSettings DefaulSubheadSettings[]

  @@index([groupId])
  @@index([headId])
  @@map("account_subheads")
}

/// Ledger / chart row: concrete account number under group, head, and subhead.
model AccountChart {
  id                 Int      @id @default(autoincrement())
  groupId            Int      @map("group_id")
  headId             Int      @map("head_id")
  subheadId          Int      @map("sub_head_id")
  accountNo          String?  @map("account_no")
  accountRef         String?  @map("account_ref")
  accountDescription String   @map("account_description")
  status             Status   @default(Active)
  rank               Int
  createdAt          DateTime @default(now()) @map("created_at")

  group                           AccountGroup                     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  head                            AccountHead                      @relation(fields: [headId], references: [id], onDelete: Restrict)
  subhead                         AccountSubhead                   @relation(fields: [subheadId], references: [id], onDelete: Restrict)
  accountTransactions             AccountTransaction[]
  tempJournalTransfers            TempJournalTransfer[]
  defaultAccountSettings          DefaultAccountSettings[]
  concessionDiscounts             ConcessionDiscount[]
  billingItems                    BillingItem[]
  students                        Student[]
  consumableCategories            Category[]                       @relation("CategoryConsumableAccount")
  assetCategories                 Category[]                       @relation("CategoryAssetAccount")
  studentJournalTransfers         StudentJournalTransfer[]
  // suppliers               Supplier[]
  cashiers                        Cashier[]
  staffJournalTransfers           StaffJournalTransfer[]
  salaryComponents                SalaryComponent[]
  administrativeExpenseComponents AdministrativeExpenseComponent[]

  @@index([groupId])
  @@index([headId])
  @@index([subheadId])
  @@map("account_charts")
}

/// Posted ledger line (double-entry detail).
model AccountTransaction {
  id              Int      @id @default(autoincrement())
  groupId         Int      @map("group_id")
  headId          Int      @map("head_id")
  subheadId       Int      @map("sub_head_id")
  accountId       Int      @map("account_id")
  accountCode     String?  @map("account_code")
  accountSub      String?  @map("account_sub")
  debit           Decimal  @default(0) @db.Decimal(14, 2)
  credit          Decimal  @default(0) @db.Decimal(14, 2)
  remarks         String?  @map("remarks")
  ref             String?  @map("reference_no")
  manualRef       String?  @map("manual_reference_no")
  transactionDate DateTime @map("transaction_date")
  postedBy        String?  @map("posted_by")
  createdAt       DateTime @default(now()) @map("created_at")
  projectId       String?  @map("project_id") @db.Char(36)

  group   AccountGroup   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  head    AccountHead    @relation(fields: [headId], references: [id], onDelete: Restrict)
  subhead AccountSubhead @relation(fields: [subheadId], references: [id], onDelete: Restrict)
  account AccountChart   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  project Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([headId])
  @@index([subheadId])
  @@index([accountId])
  @@index([projectId])
  @@index([transactionDate])
  @@index([accountSub])
  @@map("account_transactions")
}

/// Staging journal lines before transfer to the live ledger.
model TempJournalTransfer {
  id                Int                 @id @default(autoincrement())
  transType         JournalTransferType @map("transaction_type")
  accountId         Int                 @map("accountid")
  debit             Decimal             @default(0) @db.Decimal(14, 2)
  credit            Decimal             @default(0) @db.Decimal(14, 2)
  status            Status              @default(Active)
  batchStatus       BatchStatus         @default(Pending)
  referenceNo       String?             @map("reference_no")
  manualReferenceNo String?             @map("manual_reference_no")
  transactionDate   DateTime            @map("transaction_date")
  postedAt          DateTime?           @map("posted_at")
  postedBy          String?             @map("posted_by")
  remarks           String?             @map("remarks")
  createdAt         DateTime            @default(now()) @map("created_at")
  finalPostedAt     DateTime?           @map("final_posted_at")
  finalPostedBy     String?             @map("final_posted_by")
  projectId         String?             @map("project_id") @db.Char(36)
  updatedAt         DateTime            @default(now()) @map("updated_at")
  createdById       String?             @map("created_by") @db.Char(36)
  createdBy         User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)

  account AccountChart @relation(fields: [accountId], references: [id], onDelete: Restrict)
  project Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([projectId])
  @@index([transactionDate])
  @@index([batchStatus])
  @@map("temp_journal_transfer")
}

model StudentJournalTransfer {
  id                Int                 @id @default(autoincrement())
  transType         JournalTransferType @map("transaction_type")
  studentId         String              @map("student_id") @db.Char(36)
  student           Student?            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  accountId         Int                 @map("accountid")
  debit             Decimal             @default(0) @db.Decimal(14, 2)
  credit            Decimal             @default(0) @db.Decimal(14, 2)
  status            Status              @default(Active)
  batchStatus       BatchStatus         @default(Pending) @map("batch_status")
  referenceNo       String?             @map("reference_no")
  manualReferenceNo String?             @map("manual_reference_no")
  transactionDate   DateTime            @map("transaction_date")
  postedAt          DateTime?           @map("posted_at")
  postedBy          String?             @map("posted_by")
  remarks           String?             @map("remarks")
  createdAt         DateTime            @default(now()) @map("created_at")
  finalPostedAt     DateTime?           @map("final_posted_at")
  finalPostedBy     String?             @map("final_posted_by")
  updatedAt         DateTime            @default(now()) @map("updated_at")
  createdById       String?             @map("created_by") @db.Char(36)
  createdBy         User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  account           AccountChart        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  project           Project?            @relation(fields: [projectId], references: [id])
  projectId         String?             @db.Char(36)

  @@index([studentId])
  @@index([accountId])
  @@index([transactionDate])
  @@index([batchStatus])
  @@map("student_journal_transfer")
}

model DefaulSubheadSettings {
  settingsId String          @unique
  settings   String          @map("settings")
  subheadId  Int?            @map("subhead_id")
  subhead    AccountSubhead? @relation(fields: [subheadId], references: [id], onDelete: Restrict)

  @@index([settingsId])
  @@map("defaul_subhead_settings")
}

model DefaultAccountSettings {
  settingsId String        @unique
  settings   String        @map("settings")
  accountId  Int?          @map("account_id")
  account    AccountChart? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([settingsId])
  @@map("default_account_settings")
}

enum BillingItemCategory {
  TUITION
  MATERIALS
  SERVICES
  TRANSPORTATION
  TECHNOLOGY
  UTILITIES
  CONSTRUCTION
  FEEDING
  MEDICAL
  OTHER
}

model BillingItem {
  id                   Int                               @id @default(autoincrement())
  code                 String                            @unique
  name                 String
  category             BillingItemCategory
  optional             Boolean                           @default(false)
  status               Status                            @default(Active)
  createdAt            DateTime                          @default(now()) @map("created_at")
  updatedAt            DateTime                          @updatedAt @map("updated_at")
  concessionLinks      BillingItemToConcessionDiscount[]
  accountId            Int?                              @map("account_id")
  account              AccountChart?                     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  studentBillings      StudentBilling[]
  classDefaultBillings ClassDefaultBilling[]

  @@index([code])
  @@index([category])
  @@index([status])
  @@map("billing_items")
}

enum ConcessionDiscountType {
  CONCESSION
  DISCOUNT
}

enum ConcessionDiscountCalculationType {
  PERCENTAGE
  FIXED_AMOUNT
}

model ConcessionDiscount {
  id                         Int                               @id @default(autoincrement())
  code                       String                            @unique
  name                       String
  type                       ConcessionDiscountType
  calculationType            ConcessionDiscountCalculationType @map("calculation_type")
  value                      Decimal                           @db.Decimal(14, 2)
  billingItemLinks           BillingItemToConcessionDiscount[]
  maxLimit                   Decimal?                          @map("max_limit") @db.Decimal(14, 2)
  status                     Status                            @default(Active)
  accountId                  Int?                              @map("account_id")
  account                    AccountChart?                     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  studentConcessionDiscounts StudentConcessionDiscount[]

  @@index([code])
  @@index([type])
  @@index([calculationType])
  @@index([status])
  @@map("concession_discounts")
}

/// Explicit join table (replaces Prisma implicit `_BillingItemToConcessionDiscount`).
model BillingItemToConcessionDiscount {
  billingItemId        Int                @map("billing_item_id")
  billingItem          BillingItem        @relation(fields: [billingItemId], references: [id], onDelete: Cascade)
  concessionDiscountId Int                @map("concession_discount_id")
  concessionDiscount   ConcessionDiscount @relation(fields: [concessionDiscountId], references: [id], onDelete: Cascade)

  @@id([billingItemId, concessionDiscountId])
  @@index([concessionDiscountId])
  @@map("_billing_item_to_concession_discount")
}

enum StudentBillingStatus {
  DRAFT
  APPROVED
  CANCELLED
}

model ClassDefaultBilling {
  id         Int          @id @default(autoincrement())
  classId    String       @map("class_id") @db.Char(36)
  subclassId String?      @map("subclass_id") @db.Char(36)
  session    String       @map("session") @db.Char(36)
  term       String       @map("term") @db.Char(36)
  billingId  Int          @map("billing_id")
  billing    BillingItem? @relation(fields: [billingId], references: [id], onDelete: Restrict)
  amount     Decimal      @db.Decimal(14, 2)

  @@index([classId])
  @@index([subclassId])
  @@index([session])
  @@index([term])
  @@index([billingId])
  @@map("class_default_billings")
}

model StudentBilling {
  id         Int                  @id @default(autoincrement())
  studentId  String               @map("student_id") @db.Char(36)
  student    Student?             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  classId    String               @map("class_id") @db.Char(36)
  subclassId String?              @map("subclass_id") @db.Char(36)
  session    String               @map("session") @db.Char(36)
  term       String               @map("term") @db.Char(36)
  billingId  Int                  @map("billing_id")
  billing    BillingItem?         @relation(fields: [billingId], references: [id], onDelete: Restrict)
  amount     Decimal              @db.Decimal(14, 2)
  referentId String?              @map("referent_id")
  isPosted   Boolean              @default(false)
  status     StudentBillingStatus @default(DRAFT)
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")
  approvedAt DateTime?            @map("approved_at")
  approvedBy String?              @map("approved_by") @db.Char(36)
  createdBy  String?              @map("created_by") @db.Char(36)
  postedAt   DateTime?            @map("posted_at")
  postedBy   String?              @map("posted_by") @db.Char(36)

  @@index([studentId])
  @@index([classId])
  @@index([subclassId])
  @@index([session])
  @@index([term])
  @@index([billingId])
  @@index([status])
  @@index([approvedBy])
  @@index([createdBy])
  @@map("student_billings")
}

model StudentConcessionDiscount {
  id                   Int                  @id @default(autoincrement())
  studentId            String               @map("student_id") @db.Char(36)
  classId              String               @map("class_id") @db.Char(36)
  subclassId           String?              @map("subclass_id") @db.Char(36)
  session              String               @map("session") @db.Char(36)
  term                 String               @map("term") @db.Char(36)
  concessionDiscountId Int                  @map("concession_discount_id")
  concessionDiscount   ConcessionDiscount?  @relation(fields: [concessionDiscountId], references: [id], onDelete: Restrict)
  amount               Decimal              @db.Decimal(14, 2)
  referentId           String?              @map("referent_id")
  status               StudentBillingStatus @default(DRAFT)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  approvedAt           DateTime?            @map("approved_at")
  approvedBy           String?              @map("approved_by") @db.Char(36)
  createdBy            String?              @map("created_by") @db.Char(36)
  isPosted             Boolean              @default(false)
  postedAt             DateTime?            @map("posted_at")
  postedBy             String?              @map("posted_by") @db.Char(36)

  @@index([studentId])
  @@index([classId])
  @@index([subclassId])
  @@index([session])
  @@index([term])
  @@index([concessionDiscountId])
  @@index([status])
  @@index([approvedBy])
  @@index([createdBy])
  @@map("student_concession_discounts")
}

model AuditLog {
  id String @id @default(uuid())

  // Action details
  action     String // CREATE, UPDATE, DELETE, LOGIN, etc.
  entityType String // User, Invoice, Product, Payment
  entityId   String? // ID of affected record

  // User/System info
  performedById String?
  performedBy   User?   @relation(fields: [performedById], references: [id])

  // Changes
  oldValues Json?
  newValues Json?

  // Request metadata
  ipAddress String?
  userAgent String?
  requestId String?

  // Optional description
  description String?

  // Status
  status String? @default("SUCCESS")

  createdAt DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([performedById])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Cashier {
  id             String        @id @default(uuid()) @db.Char(36)
  name           String
  staffId        String?
  Staff          Staff?        @relation(fields: [staffId], references: [id])
  accountChartId Int?
  ledger         AccountChart? @relation(fields: [accountChartId], references: [id])
  status         Status
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])

  @@index([staffId])
  @@index([accountChartId])
  @@index([userId])
  @@map("cashiers")
}

model Department {
  id     String  @id @default(uuid()) @db.Char(36)
  name   String
  status Status  @default(Active)
  staff  Staff[]

  @@index([id])
  @@map("departments")
}

model GradeLevel {
  id               String           @id @default(uuid()) @db.Char(36)
  name             String
  status           Status           @default(Active)
  staff            Staff[]
  salaryCharts     SalaryChart[]
  payrollProcesses PayrollProcess[]

  @@index([id])
  @@map("grade_levels")
}

model StaffBankDetails {
  id            String  @id @default(uuid()) @db.Char(36)
  staffId       String  @map("staff_id") @db.Char(36)
  staff         Staff   @relation(fields: [staffId], references: [id])
  bankId        String  @map("bank_id") @db.Char(36)
  bank          Bank    @relation(fields: [bankId], references: [id])
  accountNumber String  @map("account_number")
  isPrimary     Boolean @default(false) @map("is_primary")
  status        Status  @default(Active)

  @@index([staffId])
  @@index([bankId])
  @@map("staff_bank_details")
}

model StaffJournalTransfer {
  id                Int                 @id @default(autoincrement())
  transType         JournalTransferType @map("transaction_type")
  staffId           String              @map("staff_id") @db.Char(36)
  staff             Staff?              @relation(fields: [staffId], references: [id], onDelete: Restrict)
  accountId         Int                 @map("accountid")
  debit             Decimal             @default(0) @db.Decimal(14, 2)
  credit            Decimal             @default(0) @db.Decimal(14, 2)
  status            Status              @default(Active)
  batchStatus       BatchStatus         @default(Pending) @map("batch_status")
  referenceNo       String?             @map("reference_no")
  manualReferenceNo String?             @map("manual_reference_no")
  transactionDate   DateTime            @map("transaction_date")
  postedAt          DateTime?           @map("posted_at")
  postedBy          String?             @map("posted_by")
  remarks           String?             @map("remarks")
  createdAt         DateTime            @default(now()) @map("created_at")
  finalPostedAt     DateTime?           @map("final_posted_at")
  finalPostedBy     String?             @map("final_posted_by")
  updatedAt         DateTime            @default(now()) @map("updated_at")
  createdById       String?             @map("created_by") @db.Char(36)
  createdBy         User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  account           AccountChart        @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([staffId])
  @@index([accountId])
  @@index([transactionDate])
  @@index([batchStatus])
  @@map("staff_journal_transfer")
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

model SalaryComponent {
  id                            String                         @id @default(uuid()) @db.Char(36)
  name                          String                         @unique
  shortName                     String?                        @map("short_name")
  type                          SalaryComponentType
  status                        Status                         @default(Active)
  isTaxable                     Boolean                        @default(false) @map("is_taxable")
  isPensionable                 Boolean                        @default(false) @map("is_pensionable")
