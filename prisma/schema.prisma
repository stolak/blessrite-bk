  supplierOrgId        String           @map("supplier_org_id") @db.Char(36)
  supplierOrg          Organization     @relation("PartsOrderSupplier", fields: [supplierOrgId], references: [id], onDelete: Restrict)
  orderingOrgId        String?          @map("ordering_org_id") @db.Char(36)
  orderingOrg          Organization?    @relation("PartsOrderOrderingOrg", fields: [orderingOrgId], references: [id], onDelete: SetNull)
  listingId            String           @map("listing_id") @db.Char(36)
  listing              PartsListing     @relation(fields: [listingId], references: [id], onDelete: Restrict)
  orderedById          String           @map("ordered_by") @db.Char(36)
  orderedBy            User             @relation("PartsOrderOrderedBy", fields: [orderedById], references: [id], onDelete: Restrict)
  quantity             Int
  requestedSnapshot    Json             @map("requested_snapshot")
  confirmedSnapshot    Json?            @map("confirmed_snapshot")
  unitPrice            Decimal?         @map("unit_price") @db.Decimal(14, 2)
  subtotal             Decimal?         @db.Decimal(14, 2)
  tax                  Decimal?         @db.Decimal(14, 2)
  fees                 Decimal?         @db.Decimal(14, 2)
  total                Decimal?         @db.Decimal(14, 2)
  expectedFulfilmentAt DateTime?        @map("expected_fulfilment_at")
  destinationType      String           @default("repair_shop") @map("destination_type")
  destinationAddress   String?          @map("destination_address") @db.Text
  recipientName        String?          @map("recipient_name")
  notes                String?          @db.Text
  status               String           @default("Requested")
  orderStatus          PartsOrderStatus @relation(fields: [status], references: [status], onDelete: Restrict)
  statusReason         String?          @map("status_reason") @db.Text
  exceptionNote        String?          @map("exception_note") @db.Text
  exceptionAt          DateTime?        @map("exception_at")
  payoutStatus         String           @default("Not Due") @map("payout_status")
  confirmedAt          DateTime?        @map("confirmed_at")
  readyAt              DateTime?        @map("ready_at")
  deliveredAt          DateTime?        @map("delivered_at")
  completedAt          DateTime?        @map("completed_at")
  cancelledAt          DateTime?        @map("cancelled_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  events        PartsOrderEvent[]
  transportJobs TransportJob[]
  ledgerEntries LedgerEntry[]

  @@index([caseId])
  @@index([supplierOrgId])
  @@index([listingId])
  @@map("parts_orders")
}

model PartsOrderEvent {
  id         String     @id @default(uuid()) @db.Char(36)
  orderId    String     @map("order_id") @db.Char(36)
  order      PartsOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType  String     @map("event_type")
  fromStatus String?    @map("from_status")
  toStatus   String?    @map("to_status")
  reason     String?    @db.Text
  actorId    String?    @map("actor_id") @db.Char(36)
  actor      User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  occurredAt DateTime   @default(now()) @map("occurred_at")

  @@index([orderId])
  @@map("parts_order_events")
}

model ConfigSetting {
  id            String   @id @default(uuid()) @db.Char(36)
  key           String
  category      String   @default("general")
  label         String
  unit          String?
  value         Decimal? @db.Decimal(14, 4)
  valueText     String?  @map("value_text") @db.Text
  previousValue Decimal? @map("previous_value") @db.Decimal(14, 4)
  previousText  String?  @map("previous_text") @db.Text
  effectiveFrom DateTime @default(now()) @map("effective_from")
  reason        String?  @db.Text
  createdById   String?  @map("created_by") @db.Char(36)
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([key, effectiveFrom])
  @@map("config_settings")
}

model Payment {
  id            String       @id @default(uuid()) @db.Char(36)
  invoiceId     String       @map("invoice_id") @db.Char(36)
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  caseId        String?      @map("case_id") @db.Char(36)
  serviceCase   ServiceCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  customerId    String?      @map("customer_id") @db.Char(36)
  customer      User?        @relation("PaymentCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  amount        Decimal      @db.Decimal(14, 2)
  method        String
  status        String
  reference     String?
  providerFee   Decimal      @default(0) @map("provider_fee") @db.Decimal(14, 2)
  failureReason String?      @map("failure_reason") @db.Text
  receivedAt    DateTime     @default(now()) @map("received_at")
  recordedById  String?      @map("recorded_by") @db.Char(36)
  recordedBy    User?        @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  refunds       Refund[]
  ledgerEntries LedgerEntry[]

  @@index([invoiceId])
  @@index([caseId])
  @@index([customerId])
  @@map("payments")
}

model Refund {
  id          String       @id @default(uuid()) @db.Char(36)
  paymentId   String       @map("payment_id") @db.Char(36)
  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceId   String       @map("invoice_id") @db.Char(36)
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  caseId      String?      @map("case_id") @db.Char(36)
  serviceCase ServiceCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  customerId  String?      @map("customer_id") @db.Char(36)
  customer    User?        @relation("RefundCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  amount      Decimal      @db.Decimal(14, 2)
  reason      String       @db.Text
  reference   String?
  actorId     String?      @map("actor_id") @db.Char(36)
  actor       User?        @relation("RefundActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now()) @map("created_at")

  ledgerEntries LedgerEntry[]

  @@index([paymentId])
  @@index([invoiceId])
  @@map("refunds")
}

model Payout {
  id                String        @id @default(uuid()) @db.Char(36)
  beneficiaryType   String        @map("beneficiary_type")
  orgId             String?       @map("org_id") @db.Char(36)
  organization      Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  beneficiaryUserId String?       @map("beneficiary_user_id") @db.Char(36)
  beneficiaryUser   User?         @relation("PayoutBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: SetNull)
  caseId            String?       @map("case_id") @db.Char(36)
  serviceCase       ServiceCase?  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  /// Polymorphic source: invoice, parts_order, or transport_job.
  sourceType        String        @map("source_type")
  sourceId          String        @map("source_id") @db.Char(36)
  gross             Decimal       @default(0) @db.Decimal(14, 2)
  fees              Decimal       @default(0) @db.Decimal(14, 2)
  taxes             Decimal       @default(0) @db.Decimal(14, 2)
  adjustments       Decimal       @default(0) @db.Decimal(14, 2)
  net               Decimal       @default(0) @db.Decimal(14, 2)
  status            String        @default("Payout Pending")
  statusReason      String?       @map("status_reason") @db.Text
  ruleSnapshot      Json?         @map("rule_snapshot")
  approvedById      String?       @map("approved_by") @db.Char(36)
  approvedBy        User?         @relation("PayoutApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt        DateTime?     @map("approved_at")
  completedById     String?       @map("completed_by") @db.Char(36)
  completedBy       User?         @relation("PayoutCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt       DateTime?     @map("completed_at")
  paidOn            DateTime?     @map("paid_on") @db.Date
  method            String?
  reference         String?
  evidencePath      String?       @map("evidence_path")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  adjustmentRows Adjustment[]
  ledgerEntries  LedgerEntry[]

  @@unique([sourceType, sourceId, beneficiaryType])
  @@index([orgId])
  @@index([beneficiaryUserId])
  @@index([caseId])
  @@map("payouts")
}

model Adjustment {
  id          String       @id @default(uuid()) @db.Char(36)
  target      String
  invoiceId   String?      @map("invoice_id") @db.Char(36)
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payoutId    String?      @map("payout_id") @db.Char(36)
  payout      Payout?      @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  caseId      String?      @map("case_id") @db.Char(36)
  serviceCase ServiceCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  customerId  String?      @map("customer_id") @db.Char(36)
  customer    User?        @relation("AdjustmentCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  amount      Decimal      @db.Decimal(14, 2)
  reason      String       @db.Text
  reference   String?
  actorId     String?      @map("actor_id") @db.Char(36)
  actor       User?        @relation("AdjustmentActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now()) @map("created_at")

  ledgerEntries LedgerEntry[]

  @@index([invoiceId])
  @@index([payoutId])
  @@map("adjustments")
}

/// Operational ledger for BlessRite charges, payouts, and refunds.
/// Distinct from accounting `AccountTransaction`.
model LedgerEntry {
  id                String           @id @default(uuid()) @db.Char(36)
  entryType         String           @map("entry_type")
  amount            Decimal          @db.Decimal(14, 2)
  description       String?          @db.Text
  caseId            String?          @map("case_id") @db.Char(36)
  serviceCase       ServiceCase?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  customerId        String?          @map("customer_id") @db.Char(36)
  customer          User?            @relation("LedgerCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  vehicleId         String?          @map("vehicle_id") @db.Char(36)
  vehicle           CustomerVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  invoiceId         String?          @map("invoice_id") @db.Char(36)
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentId         String?          @map("payment_id") @db.Char(36)
  payment           Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  refundId          String?          @map("refund_id") @db.Char(36)
  refund            Refund?          @relation(fields: [refundId], references: [id], onDelete: SetNull)
  adjustmentId      String?          @map("adjustment_id") @db.Char(36)
  adjustment        Adjustment?      @relation(fields: [adjustmentId], references: [id], onDelete: SetNull)
  bookingId         String?          @map("booking_id") @db.Char(36)
  booking           Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  partsOrderId      String?          @map("parts_order_id") @db.Char(36)
  partsOrder        PartsOrder?      @relation(fields: [partsOrderId], references: [id], onDelete: SetNull)
  transportJobId    String?          @map("transport_job_id") @db.Char(36)
  transportJob      TransportJob?    @relation(fields: [transportJobId], references: [id], onDelete: SetNull)
  orgId             String?          @map("org_id") @db.Char(36)
  organization      Organization?    @relation(fields: [orgId], references: [id], onDelete: SetNull)
  beneficiaryUserId String?          @map("beneficiary_user_id") @db.Char(36)
  beneficiaryUser   User?            @relation("LedgerBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: SetNull)
  payoutId          String?          @map("payout_id") @db.Char(36)
  payout            Payout?          @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  reversesEntryId   String?          @map("reverses_entry_id") @db.Char(36)
  reversesEntry     LedgerEntry?     @relation("LedgerReversal", fields: [reversesEntryId], references: [id], onDelete: SetNull)
  reversals         LedgerEntry[]    @relation("LedgerReversal")
  ruleSnapshot      Json?            @map("rule_snapshot")
  createdById       String?          @map("created_by") @db.Char(36)
  createdBy         User?            @relation("LedgerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now()) @map("created_at")

  @@index([caseId])
  @@index([entryType, createdAt])
  @@map("ledger_entries")
}

model DriverProfile {
  userId           String    @id @map("user_id") @db.Char(36)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           String    @default("Active")
  statusReason     String?   @map("status_reason") @db.Text
  ratePerJob       Decimal?  @map("rate_per_job") @db.Decimal(14, 2)
  licenceNumber    String?   @map("licence_number")
  licenceExpiresOn DateTime? @map("licence_expires_on") @db.Date
  serviceArea      String?   @map("service_area")
  notes            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("driver_profiles")
}

model PartnerOverride {
  id           String        @id @default(uuid()) @db.Char(36)
  orgId        String?       @map("org_id") @db.Char(36)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  driverUserId String?       @map("driver_user_id") @db.Char(36)
  driverUser   User?         @relation("PartnerOverrideDriver", fields: [driverUserId], references: [id], onDelete: Cascade)
  reason       String        @db.Text
  validUntil   DateTime      @map("valid_until")
  createdById  String?       @map("created_by") @db.Char(36)
  createdBy    User?         @relation("PartnerOverrideCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([orgId])
  @@index([driverUserId])
  @@map("partner_overrides")
}

model PartnerApplication {
  id            String    @id @default(uuid()) @db.Char(36)
  partnerType   String    @map("partner_type")
  businessName  String?   @map("business_name")
  contactName   String    @map("contact_name")
  email         String
  phone         String
  address       String?   @db.Text
  serviceArea   String?   @map("service_area")
  details       String?   @db.Text
  licenceNumber String?   @map("licence_number")
  capabilities  Json      @default("[]")
  status        String    @default("Submitted")
  reviewNote    String?   @map("review_note") @db.Text
  reviewedById  String?   @map("reviewed_by") @db.Char(36)
  reviewedBy    User?     @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([email])
  @@map("partner_applications")
}
