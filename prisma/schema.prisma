// ---------------------------------------------------------------------------
// BlessRite service domain (ported from Supabase migrations).
// Authorization stays on User / UserRole / AppRole / Privilege.
// Customer cars are `customer_vehicles` so they do not collide with fleet `vehicles`.
// ---------------------------------------------------------------------------

/// Customer vehicle (year/make/model). Distinct from fleet `Vehicle`.
model CustomerVehicle {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int?
  make      String
  model     String
  vin       String?
  plate     String?
  colour    String?
  mileage   Int?
  photoUrl  String?  @map("photo_url")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookings       Booking[]
  cases          ServiceCase[]
  inspections    Inspection[]
  caseMedia      CaseMedia[]
  estimates      Estimate[]
  serviceHistory ServiceHistory[]
  transportJobs  TransportJob[]
  ledgerEntries  LedgerEntry[]

  @@index([userId])
  @@map("customer_vehicles")
}

model RepairShop {
  id            String   @id @default(uuid()) @db.Char(36)
  userId        String   @map("user_id") @db.Char(36)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  address       String?  @db.Text
  phone         String?
  contactPerson String?  @map("contact_person")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  bookings Booking[]

  @@index([userId])
  @@map("repair_shops")
}

model BusinessSetting {
  key       String   @id
  value     Decimal  @db.Decimal(14, 4)
  label     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("business_settings")
}

model ServiceCatalog {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String
  serviceType String   @map("service_type")
  isRoutine   Boolean  @default(true) @map("is_routine")
  flatRate    Decimal  @default(0) @map("flat_rate") @db.Decimal(14, 2)
  estMinutes  Int      @default(60) @map("est_minutes")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("service_catalog")
}

model AvailabilitySlot {
  id          String   @id @default(uuid()) @db.Char(36)
